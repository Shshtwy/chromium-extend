From 527e3635a4f987d6fb9caadb9fef759f1e15fab5 Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Tue, 18 Aug 2026 04:04:04 +0000
Subject: [PATCH 27/33] Lower the new tab page search box into thumb reach

The search box sat near the top because the shortcuts row and cards below it
used to fill the page. With those hidden by default it is a long reach on a
large phone, so the content is offset to sit around 40% down the screen.

Done with top padding rather than layout weights. The layout is measured as
wrap_content inside a scrolling container, so a weight has no bounded height to
divide, and switching it to match_parent risks breaking scrolling on pages that
do have content. Padding shifts everything down and leaves scrolling untouched.

The offset is recorded and exposed as getSearchBoxTopOffsetPx, because
onUrlFocusAnimationChanged derives the focus animation target from
getPaddingTop. Counting cosmetic padding as layout geometry sent the search box
far above the screen when tapped, so it vanished until typing re-ran the
animation. The animation now subtracts the offset.

Verified on device: the box rests around 40% and travels to the top on tap,
becoming the omnibox with the keyboard up.
---
 .../browser/ntp/NewTabPageCoordinator.java    |  6 ++-
 .../chrome/browser/ntp/NewTabPageLayout.java  | 43 +++++++++++++++++++
 2 files changed, 48 insertions(+), 1 deletion(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/ntp/NewTabPageCoordinator.java b/chrome/android/java/src/org/chromium/chrome/browser/ntp/NewTabPageCoordinator.java
index 8bb1e655df..ac7095a213 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/ntp/NewTabPageCoordinator.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/ntp/NewTabPageCoordinator.java
@@ -893,8 +893,12 @@ public class NewTabPageCoordinator implements ModuleDelegateHost {
         }
 
         // Translate so that the search box is at the top, but only upwards.
+        // Discount the cosmetic padding that lowers the search box. It is spacing, not layout
+        // geometry, and counting it here sends the search box far above the screen on focus.
         int basePosition =
-                mScrollDelegate.getVerticalScrollOffset() + mNewTabPageLayout.getPaddingTop();
+                mScrollDelegate.getVerticalScrollOffset()
+                        + mNewTabPageLayout.getPaddingTop()
+                        - mNewTabPageLayout.getSearchBoxTopOffsetPx();
         int target =
                 Math.max(
                         basePosition,
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/ntp/NewTabPageLayout.java b/chrome/android/java/src/org/chromium/chrome/browser/ntp/NewTabPageLayout.java
index c6fca8526d..645b8c8569 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/ntp/NewTabPageLayout.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/ntp/NewTabPageLayout.java
@@ -6,6 +6,7 @@ package org.chromium.chrome.browser.ntp;
 
 import android.content.Context;
 import android.util.AttributeSet;
+import android.util.DisplayMetrics;
 import android.view.View;
 import android.view.ViewGroup;
 import android.view.ViewStub;
@@ -41,8 +42,15 @@ public class NewTabPageLayout extends LinearLayout {
 
     private static final String TAG = "NewTabPageLayout";
 
+    /**
+     * Fraction of screen height added as top padding, to bring the search box within thumb reach.
+     * Tuned on a Pixel 10 Pro XL; the search box lands roughly 40% down the screen.
+     */
+    private static final float SEARCH_BOX_TOP_OFFSET_FRACTION = 0.14f;
+
     private @Nullable Delegate mDelegate;
     private @Nullable View mSearchBoxView;
+    private int mSearchBoxTopOffsetPx;
 
     /** Constructor for inflating from XML. */
     public NewTabPageLayout(Context context, AttributeSet attrs) {
@@ -56,6 +64,8 @@ public class NewTabPageLayout extends LinearLayout {
         setBackgroundColor(ChromeSemanticColorUtils.getHomeSurfaceBackgroundColor(getContext()));
 
         // TODO(crbug.com/347509698): Remove the log statements after fixing the bug.
+        applySearchBoxVerticalOffset();
+
         Log.i(TAG, "NewTabPageLayout.onFinishInflate before insertSiteSectionView");
 
         initializeSiteSectionView();
@@ -105,6 +115,39 @@ public class NewTabPageLayout extends LinearLayout {
         mDelegate = delegate;
     }
 
+    /**
+     * De-Googled build: push the new tab page content down the screen.
+     *
+     * <p>The search box sits near the top because the tiles and cards below it used to fill the
+     * page. With those hidden by default it is a long reach on a large phone, so the content is
+     * offset to sit lower, closer to where a thumb rests.
+     *
+     * <p>Done with top padding rather than layout weights: this view is measured as wrap_content
+     * inside a scrolling container, so a weight would have no bounded height to divide, and
+     * switching it to match_parent risks breaking scrolling on pages that do have content.
+     * Padding shifts everything down while leaving scrolling untouched.
+     */
+    private void applySearchBoxVerticalOffset() {
+        DisplayMetrics metrics = getContext().getResources().getDisplayMetrics();
+        if (metrics == null || metrics.heightPixels <= 0) return;
+
+        mSearchBoxTopOffsetPx =
+                Math.round(metrics.heightPixels * SEARCH_BOX_TOP_OFFSET_FRACTION);
+        setPadding(getPaddingLeft(), getPaddingTop() + mSearchBoxTopOffsetPx, getPaddingRight(),
+                getPaddingBottom());
+    }
+
+    /**
+     * Returns the padding added purely to lower the search box, in pixels.
+     *
+     * <p>Callers that reason about where the search box sits, such as the URL focus animation,
+     * must subtract this. It is cosmetic spacing rather than real layout geometry, and treating it
+     * as geometry translates the search box far past the top of the screen when it is focused.
+     */
+    int getSearchBoxTopOffsetPx() {
+        return mSearchBoxTopOffsetPx;
+    }
+
     /** Sets the search box view. */
     public void setSearchBoxView(View view) {
         mSearchBoxView = view;
-- 
