From 842d6039e0cb977b64b1601340881e7382ec551c Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Tue, 18 Aug 2026 17:30:50 +0000
Subject: [PATCH 36/49] Remove the built-in Gemini and AI Mode search shortcuts

The starter pack shipped six built-in shortcuts, and two of them pointed at Google AI.
@gemini searched gemini.google.com and @aimode searched google.com with udm=50, the AI
Mode parameter. Both appeared under site search in settings and were offered in the
omnibox, on a build that removes Google AI everywhere else. Patch 0025 turned off the AI
Mode omnibox button, but the @aimode shortcut was a separate entry and survived it.

Both are removed from the engine list. The four that remain, bookmarks, history, tabs and
page, are all local chrome:// destinations.

StarterPackId::kGemini and kAiMode stay in the enum because switch statements elsewhere,
including featured_search_provider and autocomplete_match, still reference them. Those
cases simply never match now.

kCurrentDataVersion is bumped from 13 to 14. The starter pack is stored per profile and
refreshed only when the shipped version is higher than the stored one, so without the bump
an existing profile would keep serving the entries this patch removes. Entries no longer in
the shipped list that have not been user-edited are then dropped.
---
 .../template_url_starter_pack_data.cc         | 36 +++++--------------
 1 file changed, 9 insertions(+), 27 deletions(-)

diff --git a/components/search_engines/template_url_starter_pack_data.cc b/components/search_engines/template_url_starter_pack_data.cc
index 4ad0bb0eb1..eb2a4bbe45 100644
--- a/components/search_engines/template_url_starter_pack_data.cc
+++ b/components/search_engines/template_url_starter_pack_data.cc
@@ -17,7 +17,7 @@
 namespace template_url_starter_pack_data {
 
 // Update this whenever a change is made to any starter pack data.
-const int kCurrentDataVersion = 13;
+const int kCurrentDataVersion = 14;
 
 // Only update this if there's an incompatible change that requires force
 // updating the user's starter pack data. This will overwrite any of the
@@ -57,16 +57,6 @@ const StarterPackEngine tabs = {
     .type = SEARCH_ENGINE_STARTER_PACK_TABS,
 };
 
-const StarterPackEngine gemini = {
-    .name_message_id = IDS_SEARCH_ENGINES_STARTER_PACK_GEMINI_NAME,
-    .keyword_message_id = IDS_SEARCH_ENGINES_STARTER_PACK_GEMINI_KEYWORD,
-    .favicon_url = nullptr,
-    .search_url = "https://gemini.google.com/app?q={searchTerms}",
-    .destination_url = "https://gemini.google.com",
-    .id = StarterPackId::kGemini,
-    .type = SEARCH_ENGINE_STARTER_PACK_GEMINI,
-};
-
 const StarterPackEngine page = {
     .name_message_id = IDS_SEARCH_ENGINES_STARTER_PACK_PAGE_NAME,
     .keyword_message_id = IDS_SEARCH_ENGINES_STARTER_PACK_PAGE_KEYWORD,
@@ -77,23 +67,15 @@ const StarterPackEngine page = {
     .type = SEARCH_ENGINE_STARTER_PACK_PAGE,
 };
 
-const StarterPackEngine ai_mode = {
-    .name_message_id = IDS_SEARCH_ENGINES_STARTER_PACK_AI_MODE_NAME,
-    .keyword_message_id = IDS_SEARCH_ENGINES_STARTER_PACK_AI_MODE_KEYWORD,
-    .favicon_url = nullptr,
-    // - `udm=50` triggers AI mode as opposed to traditional search.
-    // - `aep=48` identifies source of the request as the omnibox as opposed to
-    //    e.g. the NTP realbox.
-    .search_url =
-        "https://www.google.com/"
-        "search?sourceid=chrome&udm=50&aep=48&q={searchTerms}",
-    .destination_url = "https://www.google.com",
-    .id = StarterPackId::kAiMode,
-    .type = SEARCH_ENGINE_STARTER_PACK_AI_MODE,
-};
-
+// De-Googled build: gemini and ai_mode are removed. They shipped as built-in @gemini and
+// @aimode shortcuts pointing at gemini.google.com and google.com/search?udm=50, so they
+// appeared under site search on a browser that otherwise has Google's AI stripped out.
+// The remaining entries are all local chrome:// destinations.
+//
+// StarterPackId::kGemini and kAiMode stay in the enum because switch statements elsewhere
+// still reference them; those cases simply never match now.
 const StarterPackEngine* engines[] = {
-    &bookmarks, &history, &tabs, &gemini, &page, &ai_mode,
+    &bookmarks, &history, &tabs, &page,
 };
 
 int GetDataVersion() {
