+package org.chromium.chrome.browser.incognito;
+
+import android.app.Activity;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.os.Environment;
+import android.view.View;
+import android.widget.Toast;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.Locale;
+
+/** Helper for taking watermarked screenshots in incognito mode. */
+public class IncognitoScreenshotHelper {
+    public static final String PREF_INCOGNITO_SCREENSHOTS = "Chrome.Incognito.AllowScreenshots";
+    public static final String PREF_SHAKE_SCREENSHOT = "Chrome.Incognito.ShakeScreenshot";
+
+    public static boolean isIncognitoScreenshotAllowed() {
+        return ChromeSharedPreferences.getInstance()
+                .readBoolean(PREF_INCOGNITO_SCREENSHOTS, true);
+    }
+
+    public static boolean isShakeScreenshotEnabled() {
+        return isIncognitoScreenshotAllowed()
+                && ChromeSharedPreferences.getInstance()
+                        .readBoolean(PREF_SHAKE_SCREENSHOT, true);
+    }
+
+    public static void captureIncognitoView(Activity activity) {
+        if (activity == null || activity.getWindow() == null) return;
+        View decorView = activity.getWindow().getDecorView();
+        if (decorView == null || decorView.getWidth() <= 0 || decorView.getHeight() <= 0) return;
+
+        try {
+            Bitmap bitmap =
+                    Bitmap.createBitmap(
+                            decorView.getWidth(),
+                            decorView.getHeight(),
+                            Bitmap.Config.ARGB_8888);
+            Canvas canvas = new Canvas(bitmap);
+            decorView.draw(canvas);
+
+            // Draw stylized semi-transparent watermark badge in bottom right corner
+            drawWatermark(canvas, decorView.getWidth(), decorView.getHeight());
+
+            // Save image to Downloads
+            saveBitmapToDownloads(activity, bitmap);
+        } catch (Throwable ignored) {
+        }
+    }
+
+    private static void drawWatermark(Canvas canvas, int width, int height) {
+        Paint bgPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        bgPaint.setColor(Color.argb(140, 18, 18, 24));
+
+        Paint textPaint = new Paint(Paint.ANTI_ALIAS_FLAG);
+        textPaint.setColor(Color.argb(220, 255, 255, 255));
+        textPaint.setTextSize(32f);
+        textPaint.setFakeBoldText(true);
+
+        String text = "BARE INCOGNITO";
+        float textWidth = textPaint.measureText(text);
+        float padding = 24f;
+        float badgeWidth = textWidth + padding * 2;
+        float badgeHeight = 56f;
+
+        float right = width - 36f;
+        float bottom = height - 48f;
+        float left = right - badgeWidth;
+        float top = bottom - badgeHeight;
+
+        RectF rect = new RectF(left, top, right, bottom);
+        canvas.drawRoundRect(rect, 20f, 20f, bgPaint);
+        canvas.drawText(text, left + padding, top + badgeHeight * 0.68f, textPaint);
+    }
+
+    private static void saveBitmapToDownloads(Activity activity, Bitmap bitmap) {
+        try {
+            File dir =
+                    Environment.getExternalStoragePublicDirectory(
+                            Environment.DIRECTORY_DOWNLOADS);
+            if (!dir.exists()) dir.mkdirs();
+
+            String timeStamp =
+                    new SimpleDateFormat("yyyyMMdd_HHmmss", Locale.ROOT).format(new Date());
+            File file = new File(dir, "Incognito_Snapshot_" + timeStamp + ".png");
+            FileOutputStream out = new FileOutputStream(file);
+            bitmap.compress(Bitmap.CompressFormat.PNG, 100, out);
+            out.flush();
+            out.close();
+
+            Toast.makeText(activity, R.string.incognito_screenshot_saved, Toast.LENGTH_SHORT).show();
+        } catch (Exception ignored) {
+        }
+    }
+}
diff --git a/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java b/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
index 8a1b2c3d4e..9b2c3d4e5f 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
@@ -48,6 +48,7 @@ import android.view.WindowManager;
 import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.incognito.IncognitoScreenshotHelper;
 
@@ -1420,6 +1421,17 @@ public class ChromeTabbedActivity extends ChromeActivity<ChromeActivityComponent> {
     private void updateWindowSecureFlags() {
         boolean isIncognito = getCurrentTabModel() != null && getCurrentTabModel().isIncognito();
+        if (isIncognito && IncognitoScreenshotHelper.isIncognitoScreenshotAllowed()) {
+            getWindow().clearFlags(WindowManager.LayoutParams.FLAG_SECURE);
+            return;
+        }
         if (isIncognito) {
             getWindow().addFlags(WindowManager.LayoutParams.FLAG_SECURE);
         } else {
             getWindow().clearFlags(WindowManager.LayoutParams.FLAG_SECURE);
         }
     }
+
+    private void onShakeGestureDetected() {
+        Tab currentTab = getActivityTab();
+        if (currentTab != null && currentTab.isIncognito()) {
+            if (IncognitoScreenshotHelper.isShakeScreenshotEnabled()) {
+                IncognitoScreenshotHelper.captureIncognitoView(this);
+            }
+            return;
+        }
+    }
 }
