From 14b557061142305e0cdcde20f4d164887874744b Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Sun, 16 Aug 2026 17:29:29 +0000
Subject: [PATCH 22/31] Offer downloads to an installed download manager

Adds a hook so a download can be handed to a separate app such as 1DM instead
of being fetched by the browser.

ChromeDownloadManagerDelegate::InterceptDownloadIfApplicable is the natural
place: it already exists to ask whether something else should take a download,
and the policy blocklist and offline pages use it the same way. Returning true
means the browser does not download the file.

The Java side builds an ACTION_VIEW intent and shows a chooser. It returns false
when no suitable app is installed, so the browser downloads the file itself and
nothing changes for anyone without a download manager.

Chromium registers as a handler for http(s) ACTION_VIEW itself, so it is
filtered out of the candidate list. Without that the chooser would offer this
browser as a destination for its own download.

Known limitation: this hook carries no cookie, so a download that depends on
being signed in will fail in the external app. Passing credentials would need a
different interception layer, not an extra argument here.

No user-facing control yet; the following patch adds one, and until then this is
inert.
---
 .../browser/download/DownloadController.java  | 68 +++++++++++++++++++
 .../download/android/download_controller.cc   | 10 +++
 .../download/android/download_controller.h    |  6 ++
 .../chrome_download_manager_delegate.cc       | 11 +++
 4 files changed, 95 insertions(+)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/download/DownloadController.java b/chrome/android/java/src/org/chromium/chrome/browser/download/DownloadController.java
index 4927beb4d2..fbf8acde91 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/download/DownloadController.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/download/DownloadController.java
@@ -8,6 +8,14 @@ import org.jni_zero.CalledByNative;
 import org.jni_zero.JniType;
 import org.jni_zero.NativeMethods;
 
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.net.Uri;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.base.Log;
 import org.chromium.build.annotations.NullMarked;
 import org.chromium.build.annotations.Nullable;
 import org.chromium.chrome.browser.pdf.PdfPage;
@@ -25,6 +33,66 @@ import org.chromium.url.GURL;
 /** Java counterpart of android DownloadController. Owned by native. */
 @NullMarked
 public class DownloadController {
+    private static final String TAG = "DownloadController";
+
+    /**
+     * De-Googled build: offer the download to an installed download manager.
+     *
+     * <p>Builds an ACTION_VIEW intent for the download and shows a chooser, so an app such as 1DM
+     * can take it. Returns true only if a chooser was actually shown, so that Chromium falls back
+     * to downloading the file itself when no suitable app is installed.
+     *
+     * <p>Chromium registers as a handler for http(s) ACTION_VIEW itself, so it is filtered out of
+     * the candidate list. Without that the chooser would offer this browser as a place to send its
+     * own download, which at best is confusing and at worst loops.
+     *
+     * <p>Known limitation: the interception point in ChromeDownloadManagerDelegate does not carry
+     * the request cookie, so a download that depends on being signed in will fail in the external
+     * app. Passing credentials needs a different interception layer.
+     */
+    @CalledByNative
+    private static boolean maybeSendToExternalDownloadManager(
+            GURL url, @JniType("std::string") String mimeType) {
+        Context context = ContextUtils.getApplicationContext();
+        if (context == null) return false;
+
+        Intent intent = new Intent(Intent.ACTION_VIEW);
+        Uri uri = Uri.parse(url.getSpec());
+        if (mimeType != null && !mimeType.isEmpty()) {
+            intent.setDataAndType(uri, mimeType);
+        } else {
+            intent.setData(uri);
+        }
+
+        PackageManager pm = context.getPackageManager();
+        String self = context.getPackageName();
+        Intent chooserTarget = null;
+        for (ResolveInfo info : pm.queryIntentActivities(intent, 0)) {
+            if (info.activityInfo == null) continue;
+            if (self.equals(info.activityInfo.packageName)) continue;
+
+            Intent candidate = new Intent(intent);
+            candidate.setPackage(info.activityInfo.packageName);
+            chooserTarget = candidate;
+            break;
+        }
+
+        if (chooserTarget == null) {
+            Log.i(TAG, "No external download handler installed, downloading in browser.");
+            return false;
+        }
+
+        Intent chooser = Intent.createChooser(intent, null);
+        chooser.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        try {
+            context.startActivity(chooser);
+            return true;
+        } catch (android.content.ActivityNotFoundException e) {
+            Log.w(TAG, "Failed to launch external download handler, downloading in browser.");
+            return false;
+        }
+    }
+
     /**
      * Called to download the given URL triggered from a tab.
      *
diff --git a/chrome/browser/download/android/download_controller.cc b/chrome/browser/download/android/download_controller.cc
index abeeb3a433..8edfa6a917 100644
--- a/chrome/browser/download/android/download_controller.cc
+++ b/chrome/browser/download/android/download_controller.cc
@@ -336,6 +336,16 @@ DownloadController::DownloadController() = default;
 
 DownloadController::~DownloadController() = default;
 
+bool DownloadController::MaybeSendToExternalDownloadManager(
+    const GURL& url,
+    const std::string& mime_type) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  JNIEnv* env = base::android::AttachCurrentThread();
+  ScopedJavaLocalRef<jobject> jurl = url::GURLAndroid::FromNativeGURL(env, url);
+  return Java_DownloadController_maybeSendToExternalDownloadManager(env, jurl,
+                                                                    mime_type);
+}
+
 void DownloadController::CreateAndroidDownload(
     const content::WebContents::Getter& wc_getter,
     const DownloadInfo& info) {
diff --git a/chrome/browser/download/android/download_controller.h b/chrome/browser/download/android/download_controller.h
index 5e17f82ca9..3ebeaa13d0 100644
--- a/chrome/browser/download/android/download_controller.h
+++ b/chrome/browser/download/android/download_controller.h
@@ -46,6 +46,12 @@ class DownloadController : public DownloadControllerBase {
   void CreateAndroidDownload(const content::WebContents::Getter& wc_getter,
                              const DownloadInfo& info) override;
 
+  // De-Googled build: offers the download to an installed download manager and
+  // returns true if one took it. Returns false when no suitable app is
+  // installed, so the caller downloads the file in the browser as usual.
+  static bool MaybeSendToExternalDownloadManager(const GURL& url,
+                                                 const std::string& mime_type);
+
   // UMA histogram enum for download storage permission requests. Keep this
   // in sync with MobileDownloadStoragePermission in histograms.xml. This should
   // be append only.
diff --git a/chrome/browser/download/chrome_download_manager_delegate.cc b/chrome/browser/download/chrome_download_manager_delegate.cc
index 27be7a3c72..2f6a1beb22 100644
--- a/chrome/browser/download/chrome_download_manager_delegate.cc
+++ b/chrome/browser/download/chrome_download_manager_delegate.cc
@@ -1164,6 +1164,17 @@ bool ChromeDownloadManagerDelegate::InterceptDownloadIfApplicable(
     bool is_transient,
     bool is_content_initiated,
     content::WebContents* web_contents) {
+#if BUILDFLAG(IS_ANDROID)
+  // De-Googled build: give an installed download manager first refusal.
+  //
+  // Returns false when no suitable app is installed, in which case the download
+  // proceeds in the browser as usual. Note this hook carries no cookie, so a
+  // download that depends on being signed in will fail in the external app.
+  if (DownloadController::MaybeSendToExternalDownloadManager(url, mime_type)) {
+    return true;
+  }
+#endif  // BUILDFLAG(IS_ANDROID)
+
   PolicyBlocklistService* service =
       ChromePolicyBlocklistServiceFactory::GetForProfile(profile_);
   policy::URLBlocklist::URLBlocklistState blocklist_state =
