+const BareMediaRegistry::Candidate* BareMediaRegistry::BestAudioFor(
+    const Candidate& video) const {
+  // Adaptive streaming splits a video into a silent video file and a separate
+  // audio file, served from the same host. When that is what happened, the
+  // video on its own is silent, and the audio track is worth offering too.
+  const Candidate* best = nullptr;
+  for (const Candidate& candidate : candidates_) {
+    if (!base::StartsWith(candidate.mime_type, "audio/",
+                          base::CompareCase::INSENSITIVE_ASCII)) {
+      continue;
