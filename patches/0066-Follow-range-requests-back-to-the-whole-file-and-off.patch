+  // the complete file rather than the piece the player wanted. Every other
+  // parameter is left exactly as it was.
+  bool found_range = false;
+  std::string rebuilt;
+  for (net::QueryIterator it(normalized); !it.IsAtEnd(); it.Advance()) {
+    const std::string_view key = it.GetKey();
+    if (key == "bytestart" || key == "byteend") {
+      found_range = true;
+      continue;
+    }
+    if (!rebuilt.empty()) {
+      rebuilt += "&";
+    }
+    rebuilt += std::string(it.GetKey()) + "=" + std::string(it.GetValue());
+  }
+  if (!found_range) {
