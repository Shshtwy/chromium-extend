+  auto add = [&](const bare::BareMediaRegistry::Candidate& candidate) {
     Java_BareMediaRegistryBridge_addCandidate(
         env, jout, candidate.url.spec(), candidate.mime_type,
         static_cast<int64_t>(candidate.size.InBytes()));
+  };
+
+  // Video first, then its audio track if the page fetched one separately. The
+  // order is the contract: Java reads position 0 as the video.
+  add(*video);
+  if (const auto* audio = registry->BestAudioFor(*video)) {
+    add(*audio);
   }
 }
 
