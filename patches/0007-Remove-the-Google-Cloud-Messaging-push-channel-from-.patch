From 1de501f3b44559e792d25342156e160bb2feded7 Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Sat, 15 Aug 2026 22:23:45 +0000
Subject: [PATCH 07/35] Remove the Google Cloud Messaging push channel from the
 manifest

Drops ChromeGcmListenerService, GCMBackgroundService and InvalidationGcmUpstreamSender, the Google Now account-access permission, and - via tools:node=remove - the c2dm RECEIVE permission and FirebaseInstanceIdReceiver.

The tools:node=remove entries are necessary because the Firebase messaging library declares both the permission and its receiver in its own manifest, and the merger re-adds them; deleting them from this file alone had no effect on the shipped APK. FirebaseInitProvider is already absent from the merged manifest, so Firebase never initialises and that receiver was orphaned regardless.

Verified by diffing the shipped manifest: ChromeGcmListenerService, GCMBackgroundService, InvalidationGcmUpstreamSender, FirebaseInstanceIdReceiver, apps.now and all three c2dm entries drop to zero, while extension entries are unchanged.

Note that this stops pushes being delivered but not Chromium attempting InstanceID registration - two GCM warnings remain at startup, confirmed present before this change. Disabling the GCM driver itself is separate work. Web Push is lost; Sync, the other consumer, is not part of this build.
---
 chrome/android/java/AndroidManifest.xml | 39 ++++++++++++++++---------
 1 file changed, 26 insertions(+), 13 deletions(-)

diff --git a/chrome/android/java/AndroidManifest.xml b/chrome/android/java/AndroidManifest.xml
index f1386aba9d..490a2ec709 100644
--- a/chrome/android/java/AndroidManifest.xml
+++ b/chrome/android/java/AndroidManifest.xml
@@ -161,10 +161,23 @@ by a child template that "extends" this file.
     <uses-permission android:name="{{ manifest_package }}.TOS_ACKED" />
 
     <uses-permission android:name="com.chrome.permission.DEVICE_EXTRAS" />
-    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />
     <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT"/>
 
-    <uses-permission android:name="com.google.android.apps.now.CURRENT_ACCOUNT_ACCESS" />
+    <!-- De-Googled build: com.google.android.apps.now.CURRENT_ACCOUNT_ACCESS
+         (Google Now account access) is not requested. -->
+
+    <!-- De-Googled build: drop the Google Cloud Messaging push channel.
+         Simply omitting these from this file is not enough - the Firebase
+         messaging library declares both the permission and its own receiver
+         in its manifest, and the merger re-adds them. tools:node="remove"
+         strips them from the merged result.
+
+         FirebaseInitProvider is already absent from the merged manifest, so
+         Firebase never initialises and FirebaseInstanceIdReceiver is orphaned
+         regardless. Web Push is lost as a consequence; Sync, the other GCM
+         consumer, is not part of this build. -->
+    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE"
+        tools:node="remove" />
 
     <!-- Permission for using pinned windowing layer for document picture-in-picture. -->
     <uses-permission android:name="android.permission.USE_PINNED_WINDOWING_LAYER" />
@@ -1066,17 +1079,17 @@ by a child template that "extends" this file.
             </intent-filter>
       </activity>
 
-        <!-- GcmListenerService for messages from GCM. -->
-        <service android:name="org.chromium.chrome.browser.services.gcm.ChromeGcmListenerService"
-            android:exported="false" >
-            <intent-filter>
-                <action android:name="com.google.firebase.MESSAGING_EVENT" />
-            </intent-filter>
-        </service>
-        <service android:name="org.chromium.chrome.browser.services.gcm.GCMBackgroundService"
-            android:exported="false"/>
-        <service android:name="org.chromium.chrome.browser.services.gcm.InvalidationGcmUpstreamSender"
-            android:exported="false"/>
+        <!-- De-Googled build: the Google Cloud Messaging services are not
+             declared. ChromeGcmListenerService existed only to receive
+             com.google.firebase.MESSAGING_EVENT; GCMBackgroundService and
+             InvalidationGcmUpstreamSender were started from it, to dispatch
+             pushes and to send Sync invalidations upstream respectively. -->
+
+        <!-- Strip the Firebase messaging receiver that the library manifest
+             merges in. Its only job is to hand com.google.android.c2dm.intent.RECEIVE
+             broadcasts to Firebase, which is not initialised in this build. -->
+        <receiver android:name="com.google.firebase.iid.FirebaseInstanceIdReceiver"
+            tools:node="remove" />
 
         <!-- Android Notification service listener -->
         <service android:name="org.chromium.chrome.browser.notifications.NotificationService"
