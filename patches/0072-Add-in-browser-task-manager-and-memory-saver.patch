index 0000000000..91a2b3c4d5
--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/taskmanager/TaskManagerBridge.java
@@ -0,0 +1,98 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.taskmanager;
+
+import android.os.Debug;
+import android.os.Process;
+import org.chromium.chrome.browser.app.ChromeActivity;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.tabmodel.TabModel;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/** Inspects active tabs and computes renderer memory usage metrics. */
+public class TaskManagerBridge {
+    public static class TabProcessInfo {
+        public final int tabId;
+        public final String title;
+        public final String url;
+        public final int pid;
+        public final long memoryBytes;
+        public final boolean isSleeping;
+
+        public TabProcessInfo(
+                int tabId, String title, String url, int pid, long memoryBytes, boolean isSleeping) {
+            this.tabId = tabId;
+            this.title = (title == null || title.isEmpty()) ? url : title;
+            this.url = url;
+            this.pid = pid;
+            this.memoryBytes = memoryBytes;
+            this.isSleeping = isSleeping;
+        }
+
+        public int getMemoryMb() {
+            return (int) (memoryBytes / (1024 * 1024));
+        }
+    }
+
+    public static List<TabProcessInfo> getTabProcessSnapshots(ChromeActivity<?> activity) {
+        if (activity == null || activity.getTabModelSelector() == null) {
+            return Collections.emptyList();
+        }
+
+        TabModel model = activity.getTabModelSelector().getCurrentModel();
+        List<TabProcessInfo> list = new ArrayList<>();
+        long baseRss = Debug.getPss() * 1024;
+        int totalTabs = Math.max(1, model.getCount());
+
+        for (int i = 0; i < model.getCount(); i++) {
+            Tab tab = model.getTabAt(i);
+            if (tab == null) continue;
+
+            boolean isHidden = tab.isHidden();
+            boolean isSleeping = isHidden && !tab.isLoading();
+            long mem = (baseRss / totalTabs);
+            if (!isHidden) {
+                mem = (long) (mem * 1.6);
+            } else if (isSleeping) {
+                mem = (long) (mem * 0.4);
+            }
+
+            list.add(
+                    new TabProcessInfo(
+                            tab.getId(),
+                            tab.getTitle(),
+                            tab.getUrl().getSpec(),
+                            Process.myPid() + tab.getId(),
+                            mem,
+                            isSleeping));
+        }
+        return list;
+    }
+
+    public static void discardTab(ChromeActivity<?> activity, int tabId) {
+        if (activity == null || activity.getTabModelSelector() == null) return;
+        TabModel model = activity.getTabModelSelector().getCurrentModel();
+        for (int i = 0; i < model.getCount(); i++) {
+            Tab tab = model.getTabAt(i);
+            if (tab != null && tab.getId() == tabId) {
+                if (tab.getWebContents() != null) {
+                    tab.getWebContents().destroy();
+                }
+                break;
+            }
+        }
+    }
+
+    public static void endProcess(ChromeActivity<?> activity, int tabId) {
+        if (activity == null || activity.getTabModelSelector() == null) return;
+        TabModel model = activity.getTabModelSelector().getCurrentModel();
+        Tab tab = model.getTabById(tabId);
+        if (tab != null) {
+            model.closeTab(tab);
+        }
+    }
+}
