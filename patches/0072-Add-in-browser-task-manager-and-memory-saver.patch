+package org.chromium.chrome.browser.taskmanager;
+
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import androidx.preference.Preference;
+import androidx.preference.PreferenceCategory;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.app.ChromeActivity;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.components.browser_ui.settings.ChromeSwitchPreference;
+import org.chromium.components.browser_ui.settings.SettingsUtils;
+import java.util.List;
+
+/** Settings screen displaying active tab memory, process usage, and task controls. */
+public class TaskManagerSettings extends ChromeBaseSettingsFragment
+        implements Preference.OnPreferenceChangeListener {
+    public static final String PREF_REALTIME_MODE = "Chrome.TaskManager.RealtimeMode";
+    public static final String PREF_AUTO_DISCARD = "Chrome.TaskManager.AutoDiscard";
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private Runnable mPollTask;
+    private boolean mIsActive;
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        getActivity().setTitle(R.string.task_manager_title);
+        SettingsUtils.addPreferencesFromResource(this, R.xml.task_manager_preferences);
+
+        ChromeSwitchPreference realtimePref =
+                (ChromeSwitchPreference) findPreference("task_manager_realtime_mode");
+        if (realtimePref != null) {
+            realtimePref.setChecked(
+                    ChromeSharedPreferences.getInstance().readBoolean(PREF_REALTIME_MODE, false));
+            realtimePref.setOnPreferenceChangeListener(this);
+        }
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        mIsActive = true;
+        refreshSnapshots();
+        if (ChromeSharedPreferences.getInstance().readBoolean(PREF_REALTIME_MODE, false)) {
+            startPolling();
+        }
+    }
+
+    @Override
+    public void onPause() {
+        super.onPause();
+        mIsActive = false;
+        stopPolling();
+    }
+
+    private void startPolling() {
+        mPollTask =
+                () -> {
+                    if (!mIsActive) return;
+                    refreshSnapshots();
+                    mHandler.postDelayed(mPollTask, 1500);
+                };
+        mHandler.postDelayed(mPollTask, 1500);
+    }
+
+    private void stopPolling() {
+        if (mPollTask != null) {
+            mHandler.removeCallbacks(mPollTask);
+            mPollTask = null;
+        }
+    }
+
+    private void refreshSnapshots() {
+        ChromeActivity<?> activity = (ChromeActivity<?>) getActivity();
+        if (activity == null) return;
+        List<TaskManagerBridge.TabProcessInfo> snapshots =
+                TaskManagerBridge.getTabProcessSnapshots(activity);
+        // Updates UI elements cleanly
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        boolean enabled = (boolean) newValue;
+        ChromeSharedPreferences.getInstance().writeBoolean(PREF_REALTIME_MODE, enabled);
+        return true;
+    }
+}
