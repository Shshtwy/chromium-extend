     private boolean mHasLogoLoadedForCurrentSearchEngine;
     private final LogoCoordinator.@Nullable VisibilityObserver mVisibilityObserver;
+    private final Context mContext;
     private @Nullable Drawable mDefaultGoogleLogoDrawable;
     private boolean mShouldShowLogo;
     private boolean mIsDefaultSearchEngineGoogle;
@@ -127,6 +128,7 @@ public class LogoMediator implements TemplateUrlServiceObserver {
             Callback<Logo> onLogoAvailableCallback,
             @Nullable VisibilityObserver visibilityObserver,
             @Nullable Drawable defaultGoogleLogoDrawable) {
+        mContext = context;
         mIsNightMode = ColorUtils.inNightMode(context);
         mLogoModel = logoModel;
         mLogoClickedCallback = logoClickedCallback;
@@ -263,6 +265,10 @@ public class LogoMediator implements TemplateUrlServiceObserver {
         // record, don't bother loading the logo image.
         if (mHasLogoLoadedForCurrentSearchEngine || mProfile == null || !mShouldShowLogo) return;
 
+        // Bare: this engine's logo ships in the APK, so there is nothing to go and fetch and the
+        // initial view is already holding the right drawable.
+        if (isBareNoAiEngine()) return;
+
         if (mLogoBridge == null) {
             mLogoBridge = new LogoBridge(mProfile);
         }
@@ -358,7 +364,20 @@ public class LogoMediator implements TemplateUrlServiceObserver {
      * @return The default Google logo drawable.
      */
     @VisibleForTesting
+    /**
+     * Bare: the no-AI DuckDuckGo entry carries its wordmark in the APK rather than fetching one,
+     * so it is served from resources here instead of through the logo bridge. The keyword has to
+     * match the engine defined in regional_capabilities_utils.cc.
+     */
+    private boolean isBareNoAiEngine() {
+        return "noai.duckduckgo.com".equals(mSearchEngineKeyword);
+    }
+
     @Nullable Drawable getDefaultGoogleLogoDrawable() {
+        if (isBareNoAiEngine()) {
+            return LogoUtils.getNoAiLogoDrawable(mContext);
+        }
+
         if (mProfile == null
                 || !TemplateUrlServiceFactory.getForProfile(mProfile)
                         .isDefaultSearchEngineGoogle()) {
diff --git a/chrome/browser/ui/android/logo/java/src/org/chromium/chrome/browser/logo/LogoUtils.java b/chrome/browser/ui/android/logo/java/src/org/chromium/chrome/browser/logo/LogoUtils.java
