@@ -123,6 +123,16 @@ public class LogoUtils {
         return ContextCompat.getDrawable(context, R.drawable.ic_google_logo);
     }
 
+    /**
+     * Returns the NOAI wordmark that ships with the no-AI DuckDuckGo engine.
+     *
+     * @param context The context used to load the resource.
+     * @return The NOAI logo drawable.
+     */
+    public static Drawable getNoAiLogoDrawable(Context context) {
+        return ContextCompat.getDrawable(context, R.drawable.ic_logo_noai);
+    }
+
     /**
      * Returns the appropriate size for a Doodle based on the current window mode.
      *
diff --git a/components/search_engines/android/template_url_service_android.cc b/components/search_engines/android/template_url_service_android.cc
index c06a97ded9..c80dfb3595 100644
--- a/components/search_engines/android/template_url_service_android.cc
+++ b/components/search_engines/android/template_url_service_android.cc
@@ -203,9 +203,20 @@ bool TemplateUrlServiceAndroid::DoesDefaultSearchEngineHaveLogo(JNIEnv* env) {
   }
   const TemplateURL* default_search_provider =
       template_url_service_->GetDefaultSearchProvider();
-  return default_search_provider &&
-         (default_search_provider->doodle_url().is_valid() ||
-          default_search_provider->logo_url().is_valid());
+  if (!default_search_provider) {
+    return false;
+  }
+
+  // Bare: the no-AI DuckDuckGo entry has no logo_url on purpose, since that gets fetched over
+  // the network to draw the new tab page logo. Its wordmark ships in the APK instead, so it
+  // does have a logo to show. The keyword has to match the engine defined in
+  // regional_capabilities_utils.cc.
+  if (default_search_provider->keyword() == u"noai.duckduckgo.com") {
+    return true;
+  }
+
+  return default_search_provider->doodle_url().is_valid() ||
+         default_search_provider->logo_url().is_valid();
 }
 
 bool TemplateUrlServiceAndroid::IsDefaultSearchEngineGoogle(JNIEnv* env) {
