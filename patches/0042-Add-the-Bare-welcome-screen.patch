--- /dev/null
+++ b/chrome/android/java/src/org/chromium/chrome/browser/bare/BareWelcomeOverlay.java
@@ -0,0 +1,218 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.bare;
+
+import android.animation.Animator;
+import android.animation.AnimatorListenerAdapter;
+import android.animation.AnimatorSet;
+import android.animation.ObjectAnimator;
+import android.app.Activity;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Build;
+import android.view.HapticFeedbackConstants;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.ViewTreeObserver;
+import android.view.animation.AccelerateInterpolator;
+import android.view.animation.DecelerateInterpolator;
+
+import androidx.annotation.RequiresApi;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+
+/**
+ * The one-time welcome shown on the first launch after install.
+ *
+ * <p>This is drawn as a view on top of the browser rather than as its own Activity. Chromium's
+ * FirstRunActivity was a separate Activity, which meant the first launch played two window open
+ * animations back to back and felt like a second app starting. Layering a view keeps the whole
+ * sequence inside one window, so the browser is simply revealed underneath when the wipe finishes.
+ */
+@NullMarked
+public class BareWelcomeOverlay {
+    private static final String PREFS_FILE = "bare_welcome";
+    private static final String KEY_SHOWN = "shown";
+
+    /** How long the circle takes to travel from the splash position down to its resting place. */
+    private static final long SETTLE_MS = 620;
+
+    /** Fade used for the copy once the circle has landed. */
+    private static final long FADE_MS = 340;
+
+    /** The radial wipe that hands over to the browser. */
+    private static final long WIPE_MS = 440;
+
+    /**
+     * Width of the icon the system splash draws, in dp.
+     *
+     * <p>Android sizes the splash icon container at 240dp and shows the inner two thirds of an
+     * adaptive icon, which is 160dp. Starting the circle at that size and at the centre of the
+     * screen means it picks up exactly where the splash left off, instead of appearing at its own
+     * size and reading as a second screen.
+     */
+    private static final float SPLASH_ICON_DP = 160f;
+
+    private BareWelcomeOverlay() {}
+
+    /** Shows the welcome once per install. Does nothing on later launches. */
+    public static void maybeShow(Activity activity) {
+        SharedPreferences prefs = activity.getSharedPreferences(PREFS_FILE, Context.MODE_PRIVATE);
+        if (prefs.getBoolean(KEY_SHOWN, false)) return;
+        prefs.edit().putBoolean(KEY_SHOWN, true).apply();
+
+        @Nullable ViewGroup root = activity.findViewById(android.R.id.content);
+        if (root == null) return;
+
+        View overlay =
+                LayoutInflater.from(activity)
+                        .inflate(R.layout.bare_welcome_overlay, root, /* attachToRoot= */ false);
+        root.addView(overlay);
+
+        View circle = overlay.findViewById(R.id.bare_welcome_circle);
+        View copy = overlay.findViewById(R.id.bare_welcome_copy);
+        View label = overlay.findViewById(R.id.bare_welcome_label);
+        View footer = overlay.findViewById(R.id.bare_welcome_footer);
+
+        copy.setAlpha(0f);
+        label.setAlpha(0f);
+        footer.setAlpha(0f);
+
+        // Park the circle where the splash drew its icon as soon as there is a layout, so the
+        // overlay already matches the splash before the splash goes away.
+        overlay.getViewTreeObserver()
+                .addOnGlobalLayoutListener(
+                        new ViewTreeObserver.OnGlobalLayoutListener() {
+                            @Override
+                            public void onGlobalLayout() {
+                                if (circle.getWidth() == 0) return;
+                                overlay.getViewTreeObserver().removeOnGlobalLayoutListener(this);
+                                placeAtSplash(overlay, circle);
+                                if (Build.VERSION.SDK_INT < Build.VERSION_CODES.S) {
+                                    playEntry(circle, copy, label, footer);
+                                }
+                            }
+                        });
+
+        // Drive the travel off the splash leaving rather than off layout.
+        //
+        // Layout happens while the splash is still on screen, so animating there ran the whole
+        // travel behind it: the splash then faded out over a circle already parked at the bottom,
+        // which read as one screen dissolving into another. Taking the exit ourselves lets the
+        // splash be removed on the same frame the travel starts, so the circle appears to carry
+        // straight on from it.
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
+            takeOverSplashExit(activity, () -> playEntry(circle, copy, label, footer));
+        }
+
+        circle.setOnClickListener(
+                view -> {
+                    view.performHapticFeedback(HapticFeedbackConstants.CONFIRM);
+                    view.setOnClickListener(null);
+                    playWipe(root, overlay, circle, copy, label, footer);
+                });
+    }
+
+    /** Puts the circle exactly where, and at the size, the system splash drew its icon. */
+    private static void placeAtSplash(View overlay, View circle) {
+        float fromCentre =
+                (overlay.getHeight() / 2f) - (circle.getTop() + circle.getHeight() / 2f);
+        float splashPx = SPLASH_ICON_DP * overlay.getResources().getDisplayMetrics().density;
+        float fromScale = splashPx / circle.getWidth();
+
+        circle.setTranslationY(fromCentre);
+        circle.setScaleX(fromScale);
+        circle.setScaleY(fromScale);
+    }
+
+    /** Removes the splash without its fade and starts the travel on the same frame. */
+    @RequiresApi(Build.VERSION_CODES.S)
+    private static void takeOverSplashExit(Activity activity, Runnable onSplashGone) {
+        activity.getSplashScreen()
+                .setOnExitAnimationListener(
+                        splashView -> {
+                            splashView.remove();
+                            onSplashGone.run();
+                        });
+    }
+
+    /** Slides the circle down from where the system splash drew it, then fades the copy in. */
+    private static void playEntry(View circle, View copy, View label, View footer) {
+        float fromCentre = circle.getTranslationY();
+        float fromScale = circle.getScaleX();
+
+        ObjectAnimator settle = ObjectAnimator.ofFloat(circle, View.TRANSLATION_Y, fromCentre, 0f);
+        ObjectAnimator shrinkX = ObjectAnimator.ofFloat(circle, View.SCALE_X, fromScale, 1f);
+        ObjectAnimator shrinkY = ObjectAnimator.ofFloat(circle, View.SCALE_Y, fromScale, 1f);
+
+        AnimatorSet travel = new AnimatorSet();
+        travel.playTogether(settle, shrinkX, shrinkY);
+        travel.setDuration(SETTLE_MS);
+        travel.setInterpolator(new DecelerateInterpolator(1.6f));
+
+        AnimatorSet reveal = new AnimatorSet();
+        reveal.playTogether(
+                fadeIn(copy), fadeIn(label), fadeIn(footer));
+        reveal.setStartDelay(SETTLE_MS - 140);
+
+        AnimatorSet entry = new AnimatorSet();
+        entry.playTogether(travel, reveal);
+        entry.start();
+    }
+
+    /** Grows the circle until it covers the screen, then drops the overlay. */
+    private static void playWipe(
+            ViewGroup root, View overlay, View circle, View copy, View label, View footer) {
+        float centreX = circle.getX() + circle.getWidth() / 2f;
+        float centreY = circle.getY() + circle.getHeight() / 2f;
+
+        // Reach whichever corner is furthest away, so the circle covers the screen completely.
+        float toFurthestCorner =
+                (float)
+                        Math.hypot(
+                                Math.max(centreX, overlay.getWidth() - centreX),
+                                Math.max(centreY, overlay.getHeight() - centreY));
+        float scale = (2f * toFurthestCorner) / circle.getWidth();
+
+        AnimatorSet out = new AnimatorSet();
+        out.playTogether(fadeOut(copy), fadeOut(label), fadeOut(footer));
+        out.setDuration(FADE_MS / 2);
+
+        ObjectAnimator growX = ObjectAnimator.ofFloat(circle, View.SCALE_X, 1f, scale);
+        ObjectAnimator growY = ObjectAnimator.ofFloat(circle, View.SCALE_Y, 1f, scale);
+        ObjectAnimator vanish = ObjectAnimator.ofFloat(overlay, View.ALPHA, 1f, 0f);
+        vanish.setStartDelay(WIPE_MS - 120);
+        vanish.setDuration(120);
+
+        AnimatorSet wipe = new AnimatorSet();
+        wipe.playTogether(growX, growY, vanish);
+        wipe.setDuration(WIPE_MS);
+        wipe.setInterpolator(new AccelerateInterpolator(1.4f));
+        wipe.addListener(
+                new AnimatorListenerAdapter() {
+                    @Override
+                    public void onAnimationEnd(Animator animation) {
+                        root.removeView(overlay);
+                    }
+                });
+
+        AnimatorSet all = new AnimatorSet();
+        all.playSequentially(out, wipe);
+        all.start();
+    }
+
+    private static ObjectAnimator fadeIn(View view) {
+        ObjectAnimator animator = ObjectAnimator.ofFloat(view, View.ALPHA, 0f, 1f);
+        animator.setDuration(FADE_MS);
+        return animator;
+    }
+
+    private static ObjectAnimator fadeOut(View view) {
+        return ObjectAnimator.ofFloat(view, View.ALPHA, view.getAlpha(), 0f);
+    }
+}
