From ea012c26cf50c2e37104ec4ef6dfdf1c65a07fa3 Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Tue, 18 Aug 2026 20:21:18 +0000
Subject: [PATCH 40/49] Stop badging settings rows as new

Upstream superscripts "New" beside a recently added preference for its first few views,
counted per preference. Address bar and Appearance both carry it, so a fresh profile always
sees them.

It reads as an advert rather than as anything about the setting, and on a browser whose
point is the absence of that sort of thing it is out of place. One choke point sets the
label, so this is a single flag rather than a change per preference.
---
 .../org/chromium/chrome/browser/settings/MainSettings.java | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/settings/MainSettings.java b/chrome/android/java/src/org/chromium/chrome/browser/settings/MainSettings.java
index d54e5cd46b..454a4514d1 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/settings/MainSettings.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/settings/MainSettings.java
@@ -843,7 +843,12 @@ public class MainSettings extends ChromeBaseSettingsFragment
         }
 
         final int viewCount = sharedPreferences.readInt(viewCountPrefKey, 0);
-        final boolean showNewLabelForPref = !clicked && viewCount < NEW_LABEL_MAX_VIEW_COUNT;
+        // Bare Browser: never badge a settings row as "New".
+        //
+        // Upstream superscripts "New" beside a recently added preference for its first few
+        // views. Address bar and Appearance both carry it, and on a fresh profile every install
+        // sees them, which reads as an advert rather than as information about the setting.
+        final boolean showNewLabelForPref = false;
 
         if (!showNewLabelForPref) {
             pref.setTitle(title);
