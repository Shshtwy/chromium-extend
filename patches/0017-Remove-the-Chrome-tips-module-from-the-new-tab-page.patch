From 3240f62baa5f382b212b8970485e3c41afdcbb0c Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Sun, 16 Aug 2026 08:07:01 +0000
Subject: [PATCH 17/34] Remove the Chrome tips module from the new tab page

registerTipModules now registers nothing, so the tips carousel never appears.

The rotation is mostly Google promotion: history sync, sign-in, saved passwords,
password checkup, and a pitch for Safe Browsing enhanced protection, which this
build does not want in the first place. The account-backed cards cannot function
without a Google account at all.

Removing the module rather than an individual card matters. Only the Safe
Browsing tip was visible during testing, and suppressing just that one would
have left the others to surface on a later run and look like a regression.
---
 .../HomeTipsModulesProvider.java              | 25 ++++++++-----------
 1 file changed, 10 insertions(+), 15 deletions(-)

diff --git a/chrome/browser/educational_tip/java/src/org/chromium/chrome/browser/educational_tip/HomeTipsModulesProvider.java b/chrome/browser/educational_tip/java/src/org/chromium/chrome/browser/educational_tip/HomeTipsModulesProvider.java
index 725b03442b..319ef563b8 100644
--- a/chrome/browser/educational_tip/java/src/org/chromium/chrome/browser/educational_tip/HomeTipsModulesProvider.java
+++ b/chrome/browser/educational_tip/java/src/org/chromium/chrome/browser/educational_tip/HomeTipsModulesProvider.java
@@ -36,21 +36,16 @@ public class HomeTipsModulesProvider {
      */
     public static void registerTipModules(
             EducationTipModuleActionDelegate actionDelegate, ModuleRegistry moduleRegistry) {
-        boolean isSetupListActive = SetupListModuleUtils.isSetupListActive();
-        boolean showTwoCell = SetupListModuleUtils.shouldShowTwoCellLayout();
-
-        Collection<Integer> modulesToRegister =
-                getModuleTypesToRegister(isSetupListActive, showTwoCell);
-        for (@ModuleType int moduleType : modulesToRegister) {
-            if (moduleType == ModuleType.SETUP_LIST_TWO_CELL_CONTAINER) {
-                moduleRegistry.registerModule(
-                        moduleType,
-                        new EducationalTipModuleTwoCellBuilder(moduleType, actionDelegate));
-            } else {
-                moduleRegistry.registerModule(
-                        moduleType, new EducationalTipModuleBuilder(moduleType, actionDelegate));
-            }
-        }
+        // De-Googled build: register no tip modules, so the "Chrome tips" card never
+        // appears on the new tab page.
+        //
+        // The rotation is mostly Google promotion - history sync, sign-in, saved
+        // passwords, password checkup, and a pitch for Safe Browsing enhanced
+        // protection, which this build does not want in the first place. The
+        // account-backed ones cannot function without a Google account at all.
+        //
+        // Registering nothing removes the whole carousel rather than a single card,
+        // so the remaining tips cannot surface later and look like a regression.
     }
 
     /**
