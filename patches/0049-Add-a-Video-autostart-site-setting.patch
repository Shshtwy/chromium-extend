 .../res/xml/site_settings_preferences.xml     |  4 +++
 .../ContentSettingsResources.java             | 13 ++++++++
 .../site_settings/SiteSettingsCategory.java   |  8 ++++-
 .../site_settings/SiteSettingsUtil.java       |  1 +
 .../WebsitePermissionsFetcher.java            |  1 +
 .../strings/android/site_settings.grdp        |  9 ++++++
 7 files changed, 66 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/chrome_content_browser_client.cc b/chrome/browser/chrome_content_browser_client.cc
index 335be40e0a..09c84438bf 100644
--- a/chrome/browser/chrome_content_browser_client.cc
+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -1082,7 +1082,37 @@ blink::mojom::AutoplayPolicy GetAutoplayPolicyForWebContents(
     NOTREACHED();
   }
 
-  return DetermineWebContentsAutoplayPolicy(web_contents, result);
+  blink::mojom::AutoplayPolicy policy =
+      DetermineWebContentsAutoplayPolicy(web_contents, result);
+
+#if BUILDFLAG(IS_ANDROID)
+  // Bare Browser: honour the per-site Video autostart setting.
+  //
+  // Upstream registers ContentSettingsType::AUTOPLAY and stores it, but nothing reads it, so
+  // the setting had no effect at all. Allowed keeps whatever policy was worked out above, so
+  // leaving the setting alone changes nothing. Blocked requires a real gesture.
+  //
+  // Applied after DetermineWebContentsAutoplayPolicy rather than before it. That function has
+  // several paths which return kNoUserGestureRequired outright, for enterprise policy,
+  // delegated permissions policy, microphone or camera access, and trusted web activities, so
+  // anything set beforehand can be discarded. A user asking for autostart to be off should not
+  // be overruled by those.
+  Profile* autoplay_profile =
+      Profile::FromBrowserContext(web_contents->GetBrowserContext());
+  if (autoplay_profile) {
+    HostContentSettingsMap* settings_map =
+        HostContentSettingsMapFactory::GetForProfile(autoplay_profile);
+    const GURL& url = web_contents->GetLastCommittedURL();
+    if (settings_map && url.SchemeIsHTTPOrHTTPS() &&
+        settings_map->GetContentSetting(url, url,
+                                        ContentSettingsType::AUTOPLAY) ==
+            CONTENT_SETTING_BLOCK) {
+      policy = blink::mojom::AutoplayPolicy::kUserGestureRequired;
+    }
+  }
+#endif  // BUILDFLAG(IS_ANDROID)
+
+  return policy;
 }
 
 #if BUILDFLAG(IS_ANDROID)
