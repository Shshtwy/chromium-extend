From c573bf4f22345c787bfa822208d51f3b24cdd852 Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Sun, 16 Aug 2026 04:43:40 +0000
Subject: [PATCH 11/37] Ignore page requests to lock the screen orientation

Sites commonly call screen.orientation.lock("landscape") when entering
fullscreen video. Honouring that calls Activity.setRequestedOrientation(),
which overrides the user's system rotation lock outright: the device rotates
into landscape even when rotation has been explicitly locked, and there is no
way for the user to refuse.

Make lockOrientation() a no-op so fullscreen video follows the phone the way
every other app does. unlockOrientation() is deliberately left working, so any
orientation state set before this change can still be cleared.
---
 .../ScreenOrientationProviderImpl.java        | 27 ++++++++-----------
 1 file changed, 11 insertions(+), 16 deletions(-)

diff --git a/content/public/android/java/src/org/chromium/content/browser/ScreenOrientationProviderImpl.java b/content/public/android/java/src/org/chromium/content/browser/ScreenOrientationProviderImpl.java
index ef24dc67a4..64c80e60d2 100644
--- a/content/public/android/java/src/org/chromium/content/browser/ScreenOrientationProviderImpl.java
+++ b/content/public/android/java/src/org/chromium/content/browser/ScreenOrientationProviderImpl.java
@@ -185,22 +185,17 @@ public class ScreenOrientationProviderImpl
 
     @Override
     public void lockOrientation(@Nullable WindowAndroid window, byte webScreenOrientation) {
-        // WindowAndroid may be null if the tab is being reparented.
-        if (window == null) return;
-        Activity activity = window.getActivity().get();
-
-        // Locking orientation is only supported for web contents that have an associated activity.
-        // Note that we can't just use the focused activity, as that would lead to bugs where
-        // unlockOrientation unlocks a different activity to the one that was locked.
-        if (activity == null) return;
-
-        int orientation =
-                getOrientationFromWebScreenOrientations(webScreenOrientation, window, activity);
-        if (orientation == ActivityInfo.SCREEN_ORIENTATION_UNSPECIFIED) {
-            return;
-        }
-
-        setMaybeDelayedRequestedOrientation(activity, /* lock= */ true, orientation);
+        // De-Googled build: pages are not allowed to dictate screen orientation.
+        //
+        // Sites commonly call screen.orientation.lock("landscape") when entering
+        // fullscreen video. Honouring that calls Activity.setRequestedOrientation(),
+        // which overrides the user's system rotation lock outright - the device
+        // rotates even when the user has explicitly locked rotation. Ignoring the
+        // request leaves fullscreen video following the phone, as every other app
+        // does.
+        //
+        // unlockOrientation() is deliberately left working, so any orientation
+        // state set before this build can still be cleared.
     }
 
     @CalledByNative
