From b5cb998719452d91010b235fcf3461e53cecd711 Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Sun, 16 Aug 2026 01:55:19 +0000
Subject: [PATCH 08/42] Guard omnibox vector icon calls so the Google XR SDKs
 can be removed

AutocompleteMatch::GetVectorIcon and OmniboxAction::GetVectorIcon are declared behind (!IS_ANDROID || ENABLE_VR) && !IS_IOS. On Android that reduces to ENABLE_VR, whose default derives from enable_openxr || enable_cardboard || enable_arcore - so disabling the Google XR SDKs removed the methods while three call sites still used them unconditionally.

Guards the two searchbox handler sites and the omnibox edit model site, moving the inputs of the first inside the guard so they do not become unused under -Werror. GetMatchIcon falls back to an empty gfx::Image, which its callers already handle since the favicon paths above can also return empty.

The guard is !IS_ANDROID rather than a mirror of the header condition, which avoids adding the VR buildflag header and GN deps to two targets. Equivalent while this build always disables VR on Android.

Verified on device: omnibox suggestions still render search, favicon and navigation icons, no crash. APK drops 1.63 MB. vrcore and openxr manifest entries reach zero; ar.core, cardboard and daydream entries persist because the AAR library manifests contribute them and would need tools:node=remove.
---
 chrome/browser/ui/omnibox/omnibox_edit_model.cc      |  9 +++++++++
 .../cr_components/searchbox/searchbox_handler.cc     | 12 ++++++++++++
 2 files changed, 21 insertions(+)

diff --git a/chrome/browser/ui/omnibox/omnibox_edit_model.cc b/chrome/browser/ui/omnibox/omnibox_edit_model.cc
index 905f614f43..84750aab80 100644
--- a/chrome/browser/ui/omnibox/omnibox_edit_model.cc
+++ b/chrome/browser/ui/omnibox/omnibox_edit_model.cc
@@ -1943,11 +1943,20 @@ gfx::Image OmniboxEditModel::GetMatchIcon(const AutocompleteMatch& match,
     }
   }
 
+  // AutocompleteMatch::GetVectorIcon is declared behind
+  // `(!IS_ANDROID || ENABLE_VR) && !IS_IOS` in autocomplete_match.h. This build
+  // disables the Google XR SDKs, which forces ENABLE_VR off on Android, so the
+  // method is absent. Fall back to no image; callers already handle an empty
+  // one, since the favicon paths above can also return empty.
+#if !BUILDFLAG(IS_ANDROID)
   bool is_starred_match = IsStarredMatch(match);
   const auto& vector_icon_type = match.GetVectorIcon(is_starred_match, turl);
 
   return controller_->client()->GetSizedIcon(vector_icon_type,
                                              vector_icon_color);
+#else
+  return gfx::Image();
+#endif
 }
 
 gfx::Image OmniboxEditModel::GetMatchIconIfExtension(
diff --git a/chrome/browser/ui/webui/cr_components/searchbox/searchbox_handler.cc b/chrome/browser/ui/webui/cr_components/searchbox/searchbox_handler.cc
index 0e9bf108bc..f2b8dd9228 100644
--- a/chrome/browser/ui/webui/cr_components/searchbox/searchbox_handler.cc
+++ b/chrome/browser/ui/webui/cr_components/searchbox/searchbox_handler.cc
@@ -885,6 +885,13 @@ SearchboxHandler::CreateAutocompleteMatch(
   mojom_match->destination_url = match.destination_url;
   mojom_match->suggestion_group_id =
       match.suggestion_group_id.value_or(omnibox::GROUP_INVALID);
+  // AutocompleteMatch::GetVectorIcon is declared behind
+  // `(!IS_ANDROID || ENABLE_VR) && !IS_IOS` in autocomplete_match.h, so on
+  // Android it exists only when VR is compiled in. This build disables the
+  // Google XR SDKs, which forces ENABLE_VR off, so the method is absent and
+  // the suggestion simply carries no icon path. The inputs it needs are
+  // declared inside the guard so they do not become unused.
+#if !BUILDFLAG(IS_ANDROID)
   const bool is_bookmarked =
       bookmark_model->IsBookmarked(match.destination_url);
   // For starter pack suggestions, use template url to generate proper vector
@@ -895,6 +902,7 @@ SearchboxHandler::CreateAutocompleteMatch(
           : turl_service->GetTemplateURLForKeyword(match.associated_keyword);
   mojom_match->icon_path = AutocompleteIconToResourceName(
       match.GetVectorIcon(is_bookmarked, associated_keyword_turl));
+#endif
   // For enterprise search aggregator people suggestions, use branded icon if
   // branded build.
   if (match.enterprise_search_aggregator_type ==
@@ -966,7 +974,11 @@ SearchboxHandler::CreateAutocompleteMatch(
     for (const auto& action : match.actions) {
       std::string icon_path;
       if (action->GetIconImage().IsEmpty()) {
+        // See the note above: OmniboxAction::GetVectorIcon is behind the same
+        // guard and is absent on Android without VR.
+#if !BUILDFLAG(IS_ANDROID)
         icon_path = AutocompleteIconToResourceName(action->GetVectorIcon());
+#endif
       } else {
         icon_path = webui::GetBitmapDataUrl(action->GetIconImage().AsBitmap());
       }
