From 5a874509b7f516c0b1d276ec26942a2b29f3182f Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Tue, 18 Aug 2026 20:21:16 +0000
Subject: [PATCH 38/48] Rename the browser to Bare

The launcher entry, the widget titles, the About page and the toolbar menu description
all said Chrome or Chromium. They now say Bare.

app_name feeds more than the launcher: the About page reads its version line from it, so
that follows automatically. IDS_PREFS_ABOUT_CHROME and IDS_MENU_ABOUT_CHROME are separate
hardcoded strings and had to be changed on their own, as did the toolbar menu content
description in the ui strings, which is what a screen reader announces.

The welcome copy shipped with the other branded, untranslated strings for the same reason:
it is product wording rather than something to translate.

Nothing here touches the user agent, the chrome:// scheme or any internal identifier. Sites
still see a normal Chrome user agent, which is what keeps them behaving.
---
 .../res_chromium_base/values/channel_constants.xml  | 13 +++++++++----
 .../ui/android/strings/android_chrome_strings.grd   |  6 +++---
 ui/android/java/strings/android_ui_strings.grd      |  2 +-
 3 files changed, 13 insertions(+), 8 deletions(-)

diff --git a/chrome/android/java/res_chromium_base/values/channel_constants.xml b/chrome/android/java/res_chromium_base/values/channel_constants.xml
index cc1f2a30cb..b8760a5ae2 100644
--- a/chrome/android/java/res_chromium_base/values/channel_constants.xml
+++ b/chrome/android/java/res_chromium_base/values/channel_constants.xml
@@ -7,8 +7,13 @@ found in the LICENSE file.
 
 <resources xmlns:android="http://schemas.android.com/apk/res/android">
     <!-- The application name displayed to the user. -->
-    <string name="app_name" translatable="false">Chromium</string>
-    <string name="bookmark_widget_title" translatable="false">Chromium bookmarks</string>
-    <string name="search_widget_title" translatable="false">Chromium search</string>
-    <string name="quick_action_search_widget_title" translatable="false">Chromium quick action search</string>
+    <string name="app_name" translatable="false">Bare</string>
+    <string name="bookmark_widget_title" translatable="false">Bare bookmarks</string>
+    <string name="search_widget_title" translatable="false">Bare search</string>
+    <string name="quick_action_search_widget_title" translatable="false">Bare quick action search</string>
+
+    <!-- One-time welcome shown on the first launch after install. -->
+    <string name="bare_welcome_body" translatable="false">Made for people who just want the web,\nwithout the extras nobody asked for.</string>
+    <string name="bare_welcome_start" translatable="false">Start</string>
+    <string name="bare_welcome_footer" translatable="false">Made with \u2764\uFE0F in San Francisco</string>
 </resources>
