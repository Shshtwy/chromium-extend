       <message name="IDS_LEGAL_INFORMATION_SUMMARY" desc="Summary for legal information" meaning="Android">
         Copyright <ph name="year">%1$d<ex>2014</ex></ph> Google LLC. All rights reserved.
@@ -4447,7 +4447,7 @@ To change this setting, <ph name="BEGIN_LINK">BEGIN_LINK</ph>delete the Chrome d
         Bookmark all tabs
       </message>
       <message name="IDS_MENU_ABOUT_CHROME" desc="Menu item for opening the 'About Chrome' page in the settings. [CHAR_LIMIT=27]">
-        About Chrome
+        About Bare
       </message>
       <message name="IDS_MENU_HELP_CENTER" desc="Menu item for opening the help center. [CHAR_LIMIT=27]">
         Help center
@@ -6773,7 +6773,7 @@ To change this setting, <ph name="BEGIN_LINK">BEGIN_LINK</ph>delete the Chrome d
         Something went wrong. Try again.
       </message>
       <message name="IDS_ACCESSIBILITY_CUSTOM_TAB_MENU_WITH_DOT" desc="Content description for the menu with a dot indicating the fallback UI for contextual page action is highlighted.">
-        Customize and control Google Chrome with a highlighted item
+        Customize and control Bare with a highlighted item
       </message>
       <message name="IDS_ACCESSIBILITY_CUSTOM_TAB_MENU_ITEM_HIGHLIGHT" desc="Announcement made when the overflow menu has a highlighted item for a recommended contextual page action.">
         <ph name="MENU_NAME">%1$s<ex>Price Tracking</ex></ph> menu is highlighted.
diff --git a/ui/android/java/strings/android_ui_strings.grd b/ui/android/java/strings/android_ui_strings.grd
