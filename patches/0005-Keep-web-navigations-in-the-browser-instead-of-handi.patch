From 73d1e506f14974ef43195de6766744676c43077f Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Sat, 15 Aug 2026 21:20:52 +0000
Subject: [PATCH 05/24] Keep web navigations in the browser instead of handing
 them to apps

Android app-link handling sends http(s) URLs to whichever app has claimed the domain, with no prompt and no in-browser setting to prevent it. Following a search result to Reddit or YouTube would leave the browser entirely.

shouldOverrideUrlLoading now returns forNoOverride for http(s) URLs. Only http(s) is diverted back to the browser; explicit external schemes (intent://, tel:, mailto:, sms:, WTAI, and app-specific schemes) fall through unchanged so those links still open their apps.

This is deliberately blunt. Some OAuth flows and deep links expect an app handoff and will now stay in the browser; if that becomes a problem the condition should be narrowed rather than the change reverted.

Not yet confirmed against a real in-page link tap - verification so far used an explicit-component intent, which partly bypasses this code path.
---
 .../external_intents/ExternalNavigationHandler.java | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/components/external_intents/android/java/src/org/chromium/components/external_intents/ExternalNavigationHandler.java b/components/external_intents/android/java/src/org/chromium/components/external_intents/ExternalNavigationHandler.java
index 654a498e50..a7c588eb42 100644
--- a/components/external_intents/android/java/src/org/chromium/components/external_intents/ExternalNavigationHandler.java
+++ b/components/external_intents/android/java/src/org/chromium/components/external_intents/ExternalNavigationHandler.java
@@ -720,6 +720,19 @@ public class ExternalNavigationHandler implements ExternalNavigationHelper {
      */
     public OverrideUrlLoadingResult shouldOverrideUrlLoading(ExternalNavigationParams params) {
         if (debug()) Log.i(TAG, "shouldOverrideUrlLoading called on " + params.getUrl().getSpec());
+
+        // De-Googled build: keep web navigations in the browser. Android app-link
+        // handling otherwise sends http(s) URLs to whichever app has claimed the
+        // domain, with no prompt and no in-browser setting to prevent it.
+        //
+        // Only http(s) is diverted back to the browser. Explicit external schemes
+        // (intent://, tel:, mailto:, sms:, WTAI, and app-specific schemes) fall
+        // through unchanged, so those links still open their apps as expected.
+        if (UrlUtilities.isHttpOrHttps(params.getUrl())) {
+            if (debug()) Log.i(TAG, "Keeping http(s) navigation in the browser.");
+            return OverrideUrlLoadingResult.forNoOverride();
+        }
+
         Intent targetIntent;
         boolean isIntentUrl = UrlUtilities.hasIntentScheme(params.getUrl());
         // Perform generic parsing of the URI to turn it into an Intent.
