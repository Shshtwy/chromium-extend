From 6baa2a5c6df216e8d545dcf313073d5f26193c12 Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Tue, 18 Aug 2026 16:20:52 +0000
Subject: [PATCH 32/35] Lower the new tab page search box to the middle of the
 screen

Patch 0027 added a top padding that put the search box roughly 40% down the screen, to
bring it within thumb reach on a tall phone. Using it on a Pixel 10 Pro XL showed that
is still higher than it needs to be, and the middle of the screen is the easier target
one handed.

The offset is a fraction of screen height applied as top padding, so it only moves the
box on the new tab page and leaves the loaded page layout alone. 0.24 of the height
lands it at about the halfway point.
---
 .../src/org/chromium/chrome/browser/ntp/NewTabPageLayout.java | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/ntp/NewTabPageLayout.java b/chrome/android/java/src/org/chromium/chrome/browser/ntp/NewTabPageLayout.java
index 645b8c8569..fb74a5dd30 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/ntp/NewTabPageLayout.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/ntp/NewTabPageLayout.java
@@ -44,9 +44,9 @@ public class NewTabPageLayout extends LinearLayout {
 
     /**
      * Fraction of screen height added as top padding, to bring the search box within thumb reach.
-     * Tuned on a Pixel 10 Pro XL; the search box lands roughly 40% down the screen.
+     * Tuned on a Pixel 10 Pro XL; the search box lands roughly 50% down the screen.
      */
-    private static final float SEARCH_BOX_TOP_OFFSET_FRACTION = 0.14f;
+    private static final float SEARCH_BOX_TOP_OFFSET_FRACTION = 0.24f;
 
     private @Nullable Delegate mDelegate;
     private @Nullable View mSearchBoxView;
-- 
2.34.1

