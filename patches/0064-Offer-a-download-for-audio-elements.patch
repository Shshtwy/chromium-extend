+        if (mParams.isAudio() && areMandatoryFlowsCompleted(getProfile())) {
+            ModelList audioGroup = new ModelList();
+            if (mParams.canSaveMedia()
+                    && UrlUtilities.isDownloadableScheme(mParams.getSrcUrl())
+                    && mMode != ContextMenuMode.THIN_WEB_VIEW) {
+                audioGroup.add(
+                        createListItem(
+                                Item.SAVE_AUDIO,
+                                /* showInProductHelp= */ false,
+                                !mIsDownloadRestrictedByPolicy));
+            }
+            if (!audioGroup.isEmpty()) {
+                groupedItems.add(audioGroup);
+            }
+        }
