@@ -217,4 +239,81 @@ public class DownloadSettings extends ChromeBaseSettingsFragment
                     }
                 }
             };
+
+    /**
+     * De-Googled build: list the download manager apps actually installed on this device.
+     *
+     * <p>Built at display time from PackageManager rather than declared in XML, so it reflects
+     * what is installed now. The first entry always asks each time, which is also the fallback
+     * when the previously chosen app has since been uninstalled.
+     */
+    private void populateDownloadManagerAppList() {
+        ListPreference pref = (ListPreference) findPreference(PREF_EXTERNAL_DOWNLOAD_MANAGER_APP);
+        if (pref == null) return;
+
+        // Without this the selection is never reported, so the write below never happens and the
+        // list snaps back to asking every time.
+        pref.setOnPreferenceChangeListener(this);
+
+        Context context = getContext();
+        if (context == null) return;
+        PackageManager pm = context.getPackageManager();
+
+        Intent probe = new Intent(Intent.ACTION_VIEW);
+        probe.setDataAndType(Uri.parse("https://example.com/file.bin"), "application/octet-stream");
+
+        List<CharSequence> labels = new ArrayList<>();
+        List<CharSequence> values = new ArrayList<>();
+        labels.add(context.getString(R.string.external_download_manager_ask));
+        values.add("");
+
+        // Listed per activity rather than per package. An app can register several activities
+        // for the same intent, and they are genuinely different destinations: 1DM offers both its
+        // downloader and its own browser. Collapsing them by package would leave Android asking
+        // which one to use even after a choice was made here.
+        String self = context.getPackageName();
+        for (ResolveInfo info : pm.queryIntentActivities(probe, 0)) {
+            if (info.activityInfo == null) continue;
+            String pkg = info.activityInfo.packageName;
+            if (self.equals(pkg)) continue;
+
+            String component =
+                    new ComponentName(pkg, info.activityInfo.name).flattenToString();
+            if (values.contains(component)) continue;
+
+            CharSequence label = info.loadLabel(pm);
+            if (label == null || label.length() == 0) label = pkg;
+            // Two activities in one app often share a label. Distinguish them so the list is not
+            // two identical-looking rows.
+            if (labels.contains(label)) {
+                CharSequence appLabel = info.activityInfo.applicationInfo.loadLabel(pm);
+                label = appLabel + " (" + info.activityInfo.name.substring(
+                        info.activityInfo.name.lastIndexOf('.') + 1) + ")";
+            }
+            labels.add(label);
+            values.add(component);
+        }
+
+        pref.setEntries(labels.toArray(new CharSequence[0]));
+        pref.setEntryValues(values.toArray(new CharSequence[0]));
+
+        String stored =
+                ChromeSharedPreferences.getInstance()
+                        .readString(ChromePreferenceKeys.DOWNLOAD_EXTERNAL_MANAGER_PACKAGE, "");
+        // An app that has since been uninstalled must not leave the setting pointing at it.
+        if (!stored.isEmpty() && !values.contains(stored)) {
+            stored = "";
+            ChromeSharedPreferences.getInstance()
+                    .writeString(ChromePreferenceKeys.DOWNLOAD_EXTERNAL_MANAGER_PACKAGE, "");
+        }
+        pref.setValue(stored);
+
+        if (values.size() == 1) {
+            pref.setEnabled(false);
+            pref.setSummary(R.string.external_download_manager_none_installed);
+        } else {
+            pref.setEnabled(true);
+            pref.setSummary(labels.get(values.indexOf(stored)));
+        }
+    }
 }
