From 6a5cbe671e3187b2999b8507d082acfd93781ae3 Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Sat, 15 Aug 2026 04:06:56 +0000
Subject: [PATCH 01/24] Fix two Desktop Android crashes from the 2026-08-09
 report

Crash 1: ExtensionActionPopupContents.handleKeyboardEvent passed a nullable Android KeyEvent through to KeyboardShortcuts, which dereferenced it without a null check. A synthetic web keyboard event can legitimately lack an Android KeyEvent, so treat a null event as unhandled and return false.

Crash 2: NullAccountManagerDelegate.createAddAccountIntent threw UnsupportedOperationException by design, but the sign-in UI still exposed an Add Account action that invoked it. Return null through the callback instead of throwing.

Both were captured on a Pixel Fold running 153.0.7999.0.
---
 .../ExtensionActionPopupContents.java         |  5 ++-
 components/signin/public/android/BUILD.gn     |  1 +
 .../signin/NullAccountManagerDelegate.java    |  4 +-
 .../NullAccountManagerDelegateTest.java       | 38 +++++++++++++++++++
 4 files changed, 44 insertions(+), 4 deletions(-)
 create mode 100644 components/signin/public/android/junit/src/org/chromium/components/signin/NullAccountManagerDelegateTest.java

diff --git a/chrome/browser/ui/android/extensions/java/src/org/chromium/chrome/browser/ui/extensions/ExtensionActionPopupContents.java b/chrome/browser/ui/android/extensions/java/src/org/chromium/chrome/browser/ui/extensions/ExtensionActionPopupContents.java
index 35ed1c2a26..c2dcde6cdd 100644
--- a/chrome/browser/ui/android/extensions/java/src/org/chromium/chrome/browser/ui/extensions/ExtensionActionPopupContents.java
+++ b/chrome/browser/ui/android/extensions/java/src/org/chromium/chrome/browser/ui/extensions/ExtensionActionPopupContents.java
@@ -119,8 +119,9 @@ public class ExtensionActionPopupContents implements Destroyable {
     }
 
     @CalledByNative
-    private boolean handleKeyboardEvent(WebContents webContents, KeyEvent event) {
-        if (mDelegate != null) {
+    private boolean handleKeyboardEvent(
+            WebContents webContents, @Nullable KeyEvent event) {
+        if (mDelegate != null && event != null) {
             return mDelegate.handleKeyboardEvent(webContents, event);
         }
         return false;
