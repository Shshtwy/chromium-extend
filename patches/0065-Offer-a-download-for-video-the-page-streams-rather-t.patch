+package org.chromium.chrome.browser.bare;
+
+import org.jni_zero.CalledByNative;
+import org.jni_zero.JniType;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.url.GURL;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Reads back the media a tab has fetched, as recorded by BareMediaRegistry on the native side.
+ *
+ * <p>Nothing here starts a download or touches the network. It answers one question, what media
+ * has this tab loaded, and leaves acting on the answer to the context menu.
+ */
+@NullMarked
+public class BareMediaRegistryBridge {
+    /** One piece of media the tab fetched. */
+    public static class Candidate {
+        public final GURL url;
+        public final String mimeType;
+        public final long sizeBytes;
+
+        Candidate(GURL url, String mimeType, long sizeBytes) {
+            this.url = url;
+            this.mimeType = mimeType;
+            this.sizeBytes = sizeBytes;
+        }
+
+        public boolean isVideo() {
+            return mimeType.startsWith("video/");
+        }
+
+        public boolean isAudio() {
+            return mimeType.startsWith("audio/");
+        }
+    }
+
+    private BareMediaRegistryBridge() {}
+
+    /** Returns what the tab has fetched, oldest first. Empty if it has fetched nothing. */
+    public static List<Candidate> getCandidates(@Nullable WebContents webContents) {
+        List<Candidate> candidates = new ArrayList<>();
+        if (webContents == null || webContents.isDestroyed()) return candidates;
+        BareMediaRegistryBridgeJni.get().getCandidates(webContents, candidates);
+        return candidates;
+    }
+
+    /**
+     * Returns the largest video the tab has fetched, or null if it has fetched none. Largest is
+     * the right pick: adaptive streaming fetches several renditions of the same content, and the
+     * biggest of them is the best quality one.
+     */
+    public static @Nullable Candidate getLargestVideo(@Nullable WebContents webContents) {
+        Candidate best = null;
+        for (Candidate candidate : getCandidates(webContents)) {
+            if (!candidate.isVideo()) continue;
+            if (best == null || candidate.sizeBytes > best.sizeBytes) best = candidate;
+        }
+        return best;
+    }
+
+    @SuppressWarnings("unchecked")
+    @CalledByNative
+    private static void addCandidate(
+            Object out,
+            @JniType("std::string") String url,
+            @JniType("std::string") String mimeType,
+            long sizeBytes) {
+        ((List<Candidate>) out).add(new Candidate(new GURL(url), mimeType, sizeBytes));
+    }
+
+    @NativeMethods
+    interface Natives {
+        void getCandidates(WebContents webContents, Object out);
+    }
+}
