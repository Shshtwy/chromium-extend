+#ifndef CHROME_BROWSER_UI_ANDROID_BARE_MEDIA_REGISTRY_H_
+#define CHROME_BROWSER_UI_ANDROID_BARE_MEDIA_REGISTRY_H_
+
+#include <string>
+
+#include "base/byte_size.h"
+#include "base/containers/circular_deque.h"
+#include "content/public/browser/web_contents_observer.h"
+#include "content/public/browser/web_contents_user_data.h"
+#include "url/gurl.h"
+
+namespace bare {
+
+// Remembers the media a tab has actually fetched, so the context menu can offer
+// a download for media the page never exposes as a plain element src.
+//
+// This only watches. It observes ResourceLoadComplete, which reports what the
+// network stack has already finished doing, and never intercepts, rewrites,
+// re-requests or otherwise takes part in loading anything. There is no
+// throttle, no request handler and no second HTTP stack. A download started
+// from what is recorded here goes out through the ordinary download path like
+// any other, so the same policy checks and the same external download manager
+// handoff apply.
+//
+// The list is per tab and is dropped whenever the primary page changes.
+class BareMediaRegistry
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<BareMediaRegistry> {
+ public:
+  struct Candidate {
+    GURL url;
+    std::string mime_type;
+    base::ByteSize size;
+  };
+
+  BareMediaRegistry(const BareMediaRegistry&) = delete;
+  BareMediaRegistry& operator=(const BareMediaRegistry&) = delete;
+
+  ~BareMediaRegistry() override;
+
+  // Most recently seen last.
+  const base::circular_deque<Candidate>& candidates() const {
+    return candidates_;
+  }
+
+  // Drops the fragment and nothing else. Query parameters are kept, because on
+  // most sites they carry the signature or expiry the CDN requires and removing
+  // them turns a working URL into a 403.
+  static GURL NormalizeForDownload(const GURL& url);
+
+  // content::WebContentsObserver:
+  void ResourceLoadComplete(
+      content::RenderFrameHost* render_frame_host,
+      const content::GlobalRequestID& request_id,
+      const GURL& original_url,
+      const blink::mojom::ResourceLoadInfo& resource_load_info) override;
+  void PrimaryPageChanged(content::Page& page) override;
+
+ private:
+  explicit BareMediaRegistry(content::WebContents* web_contents);
+  friend class content::WebContentsUserData<BareMediaRegistry>;
+
+  void Remember(const GURL& url,
+                const std::string& mime_type,
+                base::ByteSize size);
+
+  base::circular_deque<Candidate> candidates_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+}  // namespace bare
+
+#endif  // CHROME_BROWSER_UI_ANDROID_BARE_MEDIA_REGISTRY_H_
