+    private static void addRow(
+            LayoutInflater inflater,
+            LinearLayout container,
+            int iconRes,
+            int labelRes,
+            String initialValue,
+            RowAction action) {
+        View row = newRow(inflater, container, iconRes, labelRes);
+        TextView value = row.findViewById(R.id.bare_option_value);
+        value.setText(initialValue);
+        row.setOnClickListener(view -> action.onTapped(value));
+        container.addView(row);
+    }
+
+    /** A row that is simply on or off, shown as a switch rather than a value to tap through. */
+    private static void addToggleRow(
+            LayoutInflater inflater,
+            LinearLayout container,
+            int iconRes,
+            int labelRes,
+            boolean initial,
+            Callback<Boolean> onChanged) {
+        View row = newRow(inflater, container, iconRes, labelRes);
+        row.findViewById(R.id.bare_option_value).setVisibility(View.GONE);
+
+        MaterialSwitch toggle = row.findViewById(R.id.bare_option_switch);
+        toggle.setVisibility(View.VISIBLE);
+        toggle.setChecked(initial);
+
+        // The whole row is the target, so the switch itself does not take the tap.
+        row.setOnClickListener(
+                view -> {
+                    toggle.setChecked(!toggle.isChecked());
+                    onChanged.onResult(toggle.isChecked());
+                });
+        container.addView(row);
+    }
+
+    private static View newRow(
+            LayoutInflater inflater, LinearLayout container, int iconRes, int labelRes) {
+        if (container.getChildCount() > 0) {
+            View divider = new View(container.getContext());
+            divider.setBackgroundColor(0xFF1F1F1F);
+            int thickness =
+                    Math.max(1, Math.round(container.getResources().getDisplayMetrics().density));
+            LinearLayout.LayoutParams params =
+                    new LinearLayout.LayoutParams(
+                            LinearLayout.LayoutParams.MATCH_PARENT, thickness);
+            // Line up with the labels rather than the icons, so the icon column reads as a column.
+            params.setMarginStart(Math.round(38 * container.getResources()
+                    .getDisplayMetrics().density));
+            container.addView(divider, params);
+        }
+
+        View row = inflater.inflate(R.layout.bare_welcome_option_row, container, false);
+        ((ImageView) row.findViewById(R.id.bare_option_icon)).setImageResource(iconRes);
+        ((TextView) row.findViewById(R.id.bare_option_label)).setText(labelRes);
+        return row;
+    }
+
+    /**
+     * The one chooser every row uses.
+     *
+     * <p>Written rather than taking the platform list dialog so it matches the screen it opens
+     * from: the same black, the same accent, a tick against what is currently set.
+     */
+    private static void showChooser(
+            Activity activity,
+            int titleRes,
+            List<CharSequence> labels,
+            int selected,
+            OnChosen callback) {
+        if (activity.isFinishing() || activity.isDestroyed()) return;
+
+        LayoutInflater inflater = LayoutInflater.from(activity);
+        View body = inflater.inflate(R.layout.bare_welcome_chooser, null);
+        ((TextView) body.findViewById(R.id.bare_chooser_title)).setText(titleRes);
+        LinearLayout list = body.findViewById(R.id.bare_chooser_options);
+
+        AlertDialog dialog = new AlertDialog.Builder(activity).setView(body).create();
+        if (dialog.getWindow() != null) {
+            // Let the rounded background above be the visible shape.
+            dialog.getWindow().setBackgroundDrawable(new ColorDrawable(Color.TRANSPARENT));
+        }
+
+        for (int i = 0; i < labels.size(); i++) {
+            View row = inflater.inflate(R.layout.bare_welcome_chooser_row, list, false);
+            ((TextView) row.findViewById(R.id.bare_chooser_label)).setText(labels.get(i));
+            row.findViewById(R.id.bare_chooser_check)
+                    .setVisibility(i == selected ? View.VISIBLE : View.INVISIBLE);
+            final int index = i;
+            row.setOnClickListener(
+                    view -> {
+                        dialog.dismiss();
+                        callback.onChosen(index);
+                    });
+            list.addView(row);
+        }
+
+        dialog.show();
+    }
+
+    /**
+     * Offers the download apps actually installed on this device.
+     *
+     * <p>Turning the setting on without saying where downloads should go would leave Android
+     * asking every time, so the choice of app is the same act as switching it on. The list is
+     * built the same way the download settings build theirs: one entry per activity, since an app
+     * can register more than one and they are genuinely different destinations.
+     */
+    private static void chooseDownloadManager(
+            Activity activity, TextView value, Choices choices) {
+        List<CharSequence> labels = new ArrayList<>();
+        List<String> components = new ArrayList<>();
+
+        labels.add(activity.getString(R.string.bare_welcome_value_off));
+        components.add(null);
+        labels.add(activity.getString(R.string.bare_welcome_value_ask));
+        components.add("");
+
+        PackageManager pm = activity.getPackageManager();
+        Intent probe = new Intent(Intent.ACTION_VIEW);
+        probe.setDataAndType(
+                Uri.parse("https://example.com/file.bin"), "application/octet-stream");
+        String self = activity.getPackageName();
+
+        for (ResolveInfo info : pm.queryIntentActivities(probe, 0)) {
+            if (info.activityInfo == null) continue;
+            String pkg = info.activityInfo.packageName;
+            if (self.equals(pkg)) continue;
+
+            String component = new ComponentName(pkg, info.activityInfo.name).flattenToString();
+            if (components.contains(component)) continue;
+
+            CharSequence label = info.loadLabel(pm);
+            if (label == null || label.length() == 0) label = pkg;
+            if (labels.contains(label)) {
+                CharSequence appLabel = info.activityInfo.applicationInfo.loadLabel(pm);
+                label =
+                        appLabel
+                                + " ("
+                                + info.activityInfo.name.substring(
+                                        info.activityInfo.name.lastIndexOf('.') + 1)
+                                + ")";
+            }
+            labels.add(label);
+            components.add(component);
+        }
+
+        int selected = 0;
+        if (choices.externalDownloadManager) {
+            int found = components.indexOf(choices.downloadManagerComponent);
+            selected = found == -1 ? 1 : found;
+        }
+
+        showChooser(
+                activity,
+                R.string.bare_welcome_opt_downloads,
+                labels,
+                selected,
+                index -> {
+                    if (index == 0) {
+                        choices.externalDownloadManager = false;
+                        choices.downloadManagerComponent = "";
+                        value.setText(R.string.bare_welcome_value_off);
+                        return;
+                    }
+                    choices.externalDownloadManager = true;
+                    choices.downloadManagerComponent = components.get(index);
+                    value.setText(labels.get(index));
+                });
+    }
+
+    /**
+     * Offers the other engines.
+     *
+     * <p>The welcome runs before native is up, so the list only exists once the profile and the
+     * template url service have loaded. Rather than show an empty picker, the tap waits for
+     * whichever of those is outstanding and opens once there is something to choose from.
+     */
+    private static void chooseSearchEngine(Activity activity, TextView value, Choices choices) {
+        whenProfileReady(
+                profile -> {
+                    TemplateUrlService service = TemplateUrlServiceFactory.getForProfile(profile);
+                    if (service.isLoaded()) {
+                        showEnginePicker(activity, service, value, choices);
+                        return;
+                    }
+                    service.registerLoadListener(
+                            new TemplateUrlService.LoadListener() {
+                                @Override
+                                public void onTemplateUrlServiceLoaded() {
+                                    service.unregisterLoadListener(this);
+                                    showEnginePicker(activity, service, value, choices);
+                                }
+                            });
+                    service.load();
+                });
+    }
+
+    private static void showEnginePicker(
+            Activity activity, TemplateUrlService service, TextView value, Choices choices) {
+        List<TemplateUrl> engines = new ArrayList<>();
+        for (TemplateUrl engine : service.getTemplateUrls()) {
+            if (engine.getIsPrepopulatedOrProgramProvided()) engines.add(engine);
+        }
+        if (engines.isEmpty()) return;
+
+        List<CharSequence> labels = new ArrayList<>();
+        int selected = 0;
+        for (int i = 0; i < engines.size(); i++) {
+            labels.add(engines.get(i).getShortName());
+            if (engines.get(i).getKeyword().equals(choices.engineKeyword)) selected = i;
+        }
+
+        showChooser(
+                activity,
+                R.string.bare_welcome_opt_search,
+                labels,
+                selected,
+                index -> {
+                    choices.engineKeyword = engines.get(index).getKeyword();
+                    value.setText(engines.get(index).getShortName());
+                });
+    }
+
+    /**
+     * Writes the choices out when Start is pressed.
+     *
+     * <p>The ones kept in shared preferences can be written straight away. The rest live in the
+     * profile's prefs, which do not exist this early in startup, so they wait for the profile
+     * rather than being dropped.
+     */
+    private static void applyChoices(Choices choices) {
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(ChromePreferenceKeys.TOOLBAR_TOP_ANCHORED, choices.addressBarOnTop);
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(
+                        ChromePreferenceKeys.DOWNLOAD_USE_EXTERNAL_DOWNLOAD_MANAGER,
+                        choices.externalDownloadManager);
+        ChromeSharedPreferences.getInstance()
+                .writeString(
+                        ChromePreferenceKeys.DOWNLOAD_EXTERNAL_MANAGER_PACKAGE,
+                        choices.downloadManagerComponent);
+        ChromeSharedPreferences.getInstance()
+                .writeBoolean(
+                        ChromePreferenceKeys.BARE_BUNDLED_AD_BLOCKER_ENABLED, choices.adBlocker);
+
+        whenProfileReady(
+                profile -> {
+                    PrefService prefs = UserPrefs.get(profile);
+                    prefs.setBoolean(
+                            Pref.AUTOFILL_USING_PLATFORM_AUTOFILL, choices.platformAutofill);
+                    prefs.setBoolean(Pref.BACKGROUND_MEDIA_PLAYBACK, choices.backgroundMedia);
+
+                    TemplateUrlService service = TemplateUrlServiceFactory.getForProfile(profile);
+                    if (service.isLoaded()) {
+                        service.setSearchEngine(choices.engineKeyword);
+                        return;
+                    }
+                    service.registerLoadListener(
+                            new TemplateUrlService.LoadListener() {
+                                @Override
+                                public void onTemplateUrlServiceLoaded() {
+                                    service.unregisterLoadListener(this);
+                                    service.setSearchEngine(choices.engineKeyword);
+                                }
+                            });
+                    service.load();
+                });
+    }
+
+    /** Runs once the regular profile exists, immediately if it already does. */
+    private static void whenProfileReady(Callback<Profile> callback) {
+        if (ProfileManager.isInitialized()) {
+            callback.onResult(ProfileManager.getLastUsedRegularProfile());
+            return;
+        }
+        ProfileManager.addObserver(
+                new ProfileManager.Observer() {
+                    @Override
+                    public void onProfileAdded(Profile profile) {
+                        if (profile.isOffTheRecord()) return;
+                        ProfileManager.removeObserver(this);
+                        callback.onResult(profile);
+                    }
+
+                    @Override
+                    public void onProfileDestroyed(Profile profile) {}
+                });
+    }
