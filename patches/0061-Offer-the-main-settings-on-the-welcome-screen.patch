+    <ImageView
+        android:id="@+id/bare_option_icon"
+        android:layout_width="22dp"
+        android:layout_height="22dp"
+        android:layout_marginEnd="16dp"
+        android:importantForAccessibility="no"
+        android:tint="@color/bare_welcome_icon" />
+
+    <TextView
+        android:id="@+id/bare_option_label"
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:layout_weight="1"
+        android:layout_marginEnd="14dp"
+        android:textColor="@color/bare_welcome_row_label"
+        android:textSize="15sp" />
+
+    <TextView
+        android:id="@+id/bare_option_value"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:maxWidth="170dp"
+        android:maxLines="1"
+        android:ellipsize="end"
+        android:textColor="@color/bare_welcome_accent"
+        android:textSize="15sp" />
+
+    <com.google.android.material.materialswitch.MaterialSwitch
+        android:id="@+id/bare_option_switch"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:clickable="false"
+        android:focusable="false"
+        android:visibility="gone" />
+</LinearLayout>
