From 325a5d64220a3c8a1bc4fbb88e0fd860e8888d62 Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Wed, 19 Aug 2026 02:05:57 +0000
Subject: [PATCH 48/49] Keep the search engine icon round in tab switcher
 thumbnails

The icon in the new tab page search box is round on the page and square in the tab switcher.

It was never a round icon, only a clipped one. The view sets an outline provider and turns on
setClipToOutline, which the render node applies while drawing with hardware acceleration and
ignores entirely when a view is drawn into a software Canvas. Thumbnails are captured exactly
that way: TabContentManager makes a Bitmap, wraps it in a Canvas and asks the native page to
draw itself into it, so the clip never happened and the underlying square bitmap showed.

Making the drawable itself circular fixes it for every draw path. The outline clip stays for
drawables that are not bitmaps and already have their own shape.

Same underlying mistake as patch 0037, approached from the other side: there the rounding
provider was built but never attached to the view, here it is attached but does not apply.
---
 .../ntp/search/SearchBoxContainerView.java    | 31 ++++++++++++++++++-
 1 file changed, 30 insertions(+), 1 deletion(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/ntp/search/SearchBoxContainerView.java b/chrome/android/java/src/org/chromium/chrome/browser/ntp/search/SearchBoxContainerView.java
index 893f932246..6bd66f86b0 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/ntp/search/SearchBoxContainerView.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/ntp/search/SearchBoxContainerView.java
@@ -7,8 +7,10 @@ package org.chromium.chrome.browser.ntp.search;
 import android.content.Context;
 import android.content.res.ColorStateList;
 import android.content.res.Resources;
+import android.graphics.Bitmap;
 import android.graphics.Rect;
 import android.graphics.Typeface;
+import android.graphics.drawable.BitmapDrawable;
 import android.graphics.drawable.Drawable;
 import android.graphics.drawable.LayerDrawable;
 import android.graphics.drawable.RippleDrawable;
@@ -25,6 +27,9 @@ import androidx.annotation.Px;
 import androidx.core.widget.ImageViewCompat;
 
 import org.chromium.build.annotations.NullMarked;
+import androidx.core.graphics.drawable.RoundedBitmapDrawable;
+import androidx.core.graphics.drawable.RoundedBitmapDrawableFactory;
+
 import org.chromium.build.annotations.Nullable;
 import org.chromium.chrome.R;
 import org.chromium.chrome.browser.composeplate.ComposeplateUtils;
@@ -108,7 +113,31 @@ public class SearchBoxContainerView extends LinearLayout {
     }
 
     void setDseIconDrawable(@Nullable Drawable drawable) {
-        mDseIconView.setImageDrawable(drawable);
+        mDseIconView.setImageDrawable(makeCircular(drawable));
+    }
+
+    /**
+     * Bakes the circle into the drawable instead of relying only on the view's outline clip.
+     *
+     * <p>setClipToOutline() is applied by the render node while drawing with hardware
+     * acceleration, and is ignored when a view is drawn into a software Canvas. The tab switcher
+     * captures native page thumbnails exactly that way, through
+     * InvalidationAwareThumbnailProvider onto a Bitmap backed Canvas, so the search engine icon
+     * stayed square in the grid while being round on the page itself.
+     *
+     * <p>The outline clip is left in place for drawables that are not bitmaps.
+     */
+    private @Nullable Drawable makeCircular(@Nullable Drawable drawable) {
+        if (!(drawable instanceof BitmapDrawable)) {
+            return drawable;
+        }
+        Bitmap bitmap = ((BitmapDrawable) drawable).getBitmap();
+        if (bitmap == null) {
+            return drawable;
+        }
+        RoundedBitmapDrawable rounded = RoundedBitmapDrawableFactory.create(getResources(), bitmap);
+        rounded.setCircular(true);
+        return rounded;
     }
 
     void setPlusButtonClickListener(@Nullable OnClickListener listener) {
