From 3757f4dc236af5f7c5da9c69bbf8611557a1e351 Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Wed, 19 Aug 2026 01:39:45 +0000
Subject: [PATCH 45/46] Remove the Autofill AI and personal context settings

The autofill settings screen offered "Smarter form understanding", which is Autofill AI, and a
personal context section wired to Google's context service. Its own description said the quiet
part plainly: to offer suggestions and improve the feature, the page URL and content are shared
with Google. That does not belong in a build whose point is that Google gets nothing.

Both are gated off at the predicates the screen actually consults, isAutofillAiEnabled() and
shouldShowPersonalContext(). Hiding the preferences after inflation does not work: the mediator
drives their visibility through a property model and puts them back on the next update.

The two copies of isAutofillAiEnabled(), in the fragment and the mediator, are paired by a LINT
IfChange comment and are changed together.

The Identity docs, Travel and Shopping rows on the Autofill and passwords screen read the same
feature, so they go as well. What remains on the options screen is the autofill service picker,
which is the part that does something.
---
 .../options/AutofillOptionsFragment.java         | 16 ++++++++++++----
 .../options/AutofillOptionsMediator.java         |  5 +++--
 2 files changed, 15 insertions(+), 6 deletions(-)

diff --git a/chrome/browser/autofill/android/java/src/org/chromium/chrome/browser/autofill/settings/options/AutofillOptionsFragment.java b/chrome/browser/autofill/android/java/src/org/chromium/chrome/browser/autofill/settings/options/AutofillOptionsFragment.java
index 9d2b3d470e..08349d34ed 100644
--- a/chrome/browser/autofill/android/java/src/org/chromium/chrome/browser/autofill/settings/options/AutofillOptionsFragment.java
+++ b/chrome/browser/autofill/android/java/src/org/chromium/chrome/browser/autofill/settings/options/AutofillOptionsFragment.java
@@ -196,8 +196,15 @@ public class AutofillOptionsFragment extends ChromeBaseSettingsFragment {
     }
 
     static boolean isAutofillAiEnabled() {
-        // LINT.IfChange(AutofillEnabledCheckFragment)
-        return ChromeFeatureList.isEnabled(ChromeFeatureList.AUTOFILL_AI_WITH_DATA_SCHEMA);
+        // Bare Browser: Autofill AI is never available.
+        //
+        // Shown as "Smarter form understanding", it sends the page URL and content to Google to
+        // offer suggestions and to improve the feature, which its own description says. That does
+        // not belong in a build whose point is that Google gets nothing.
+        //
+        // Gated here rather than by hiding the preferences, because the mediator drives their
+        // visibility through the property model and would put them straight back.
+        return false;
         // LINT.ThenChange(:AddAddAddressButtonMediator)
     }
 
@@ -206,8 +213,9 @@ public class AutofillOptionsFragment extends ChromeBaseSettingsFragment {
     }
 
     public static boolean shouldShowPersonalContext(Profile profile) {
-        return !ChromeFeatureList.isEnabled(ChromeFeatureList.YOUR_SAVED_INFO_SETTINGS_PAGE_ANDROID)
-                && AutofillPersonalContextFragment.isPersonalContextEligible(profile);
+        // Bare Browser: the personal context section feeds Google's context service, so it is
+        // never shown. See isAutofillAiEnabled() above.
+        return false;
     }
 
     public static final ChromeBaseSearchIndexProvider SEARCH_INDEX_DATA_PROVIDER =
diff --git a/chrome/browser/autofill/android/java/src/org/chromium/chrome/browser/autofill/settings/options/AutofillOptionsMediator.java b/chrome/browser/autofill/android/java/src/org/chromium/chrome/browser/autofill/settings/options/AutofillOptionsMediator.java
index a4e6cd9904..f4fbe4eb74 100644
--- a/chrome/browser/autofill/android/java/src/org/chromium/chrome/browser/autofill/settings/options/AutofillOptionsMediator.java
+++ b/chrome/browser/autofill/android/java/src/org/chromium/chrome/browser/autofill/settings/options/AutofillOptionsMediator.java
@@ -197,8 +197,9 @@ public class AutofillOptionsMediator implements ModalDialogProperties.Controller
     }
 
     private static boolean isAutofillAiEnabled() {
-        // LINT.IfChange(AutofillEnabledCheckMediator)
-        return ChromeFeatureList.isEnabled(ChromeFeatureList.AUTOFILL_AI_WITH_DATA_SCHEMA);
+        // Bare Browser: kept in step with AutofillOptionsFragment.isAutofillAiEnabled(), which
+        // the LINT pairing below requires. See the reasoning there.
+        return false;
         // LINT.ThenChange(AutofillEnabledCheckFragment)
     }
 
