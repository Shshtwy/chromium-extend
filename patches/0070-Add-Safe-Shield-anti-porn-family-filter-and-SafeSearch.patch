+package org.chromium.chrome.browser.safe_shield;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.base.annotations.CalledByNative;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.Set;
+
+/** Bridge between C++ SafeShieldThrottle and Android Java preferences & logging. */
+public class SafeShieldBridge {
+    public static final String PREF_SAFE_SHIELD_ENABLED = "Chrome.SafeShield.Enabled";
+    public static final String PREF_BLOCK_ADULT = "Chrome.SafeShield.BlockAdult";
+    public static final String PREF_FORCE_SAFESEARCH = "Chrome.SafeShield.ForceSafeSearch";
+    public static final String PREF_FAMILY_DNS = "Chrome.SafeShield.FamilyDns";
+    public static final String PREF_WHITELIST = "Chrome.SafeShield.Whitelist";
+    public static final String PREF_BLOCKED_LOG = "Chrome.SafeShield.BlockedLog";
+
+    @CalledByNative
+    public static boolean isSafeShieldEnabled() {
+        return ChromeSharedPreferences.getInstance().readBoolean(PREF_SAFE_SHIELD_ENABLED, true);
+    }
+
+    @CalledByNative
+    public static boolean isAdultBlockEnabled() {
+        return isSafeShieldEnabled()
+                && ChromeSharedPreferences.getInstance().readBoolean(PREF_BLOCK_ADULT, true);
+    }
+
+    @CalledByNative
+    public static boolean isSafeSearchForced() {
+        return isSafeShieldEnabled()
+                && ChromeSharedPreferences.getInstance().readBoolean(PREF_FORCE_SAFESEARCH, true);
+    }
+
+    @CalledByNative
+    public static boolean isHostWhitelisted(String host) {
+        if (host == null) return false;
+        Set<String> whitelist =
+                ChromeSharedPreferences.getInstance()
+                        .readStringSet(PREF_WHITELIST, new HashSet<>());
+        return whitelist.contains(host.toLowerCase(Locale.ROOT));
+    }
+
+    @CalledByNative
+    public static void recordBlockedAttempt(String url, String host) {
+        if (host == null || host.isEmpty()) return;
+        String timeStamp =
+                new SimpleDateFormat("yyyy-MM-dd HH:mm:ss", Locale.getDefault())
+                        .format(new Date());
+        String entry = timeStamp + " - " + host;
+        Set<String> logs =
+                new HashSet<>(
+                        ChromeSharedPreferences.getInstance()
+                                .readStringSet(PREF_BLOCKED_LOG, new HashSet<>()));
+        logs.add(entry);
+        ChromeSharedPreferences.getInstance().writeStringSet(PREF_BLOCKED_LOG, logs);
+    }
+}
