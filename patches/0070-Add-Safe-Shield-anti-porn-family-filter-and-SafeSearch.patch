+package org.chromium.chrome.browser.safe_shield;
+
+import android.os.Bundle;
+import androidx.preference.Preference;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.components.browser_ui.settings.ChromeSwitchPreference;
+import org.chromium.components.browser_ui.settings.SettingsUtils;
+
+/** Settings fragment for configuring Safe Shield (anti-porn filter, SafeSearch, DoH). */
+public class SafeShieldSettings extends ChromeBaseSettingsFragment
+        implements Preference.OnPreferenceChangeListener {
+    private static final String PREF_MASTER = "safe_shield_master_toggle";
+    private static final String PREF_ADULT = "safe_shield_adult_block";
+    private static final String PREF_SAFESEARCH = "safe_shield_safesearch";
+    private static final String PREF_DNS = "safe_shield_family_dns";
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        getActivity().setTitle(R.string.safe_shield_title);
+        SettingsUtils.addPreferencesFromResource(this, R.xml.safe_shield_preferences);
+
+        ChromeSwitchPreference masterPref = (ChromeSwitchPreference) findPreference(PREF_MASTER);
+        if (masterPref != null) {
+            masterPref.setChecked(
+                    ChromeSharedPreferences.getInstance()
+                            .readBoolean(SafeShieldBridge.PREF_SAFE_SHIELD_ENABLED, true));
+            masterPref.setOnPreferenceChangeListener(this);
+        }
+
+        setupSwitch(PREF_ADULT, SafeShieldBridge.PREF_BLOCK_ADULT);
+        setupSwitch(PREF_SAFESEARCH, SafeShieldBridge.PREF_FORCE_SAFESEARCH);
+        setupSwitch(PREF_DNS, SafeShieldBridge.PREF_FAMILY_DNS);
+    }
+
+    private void setupSwitch(String key, String sharedPrefKey) {
+        ChromeSwitchPreference pref = (ChromeSwitchPreference) findPreference(key);
+        if (pref != null) {
+            pref.setChecked(ChromeSharedPreferences.getInstance().readBoolean(sharedPrefKey, true));
+            pref.setOnPreferenceChangeListener(this);
+        }
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        boolean enabled = (boolean) newValue;
+        if (PREF_MASTER.equals(preference.getKey())) {
+            ChromeSharedPreferences.getInstance()
+                    .writeBoolean(SafeShieldBridge.PREF_SAFE_SHIELD_ENABLED, enabled);
+        } else if (PREF_ADULT.equals(preference.getKey())) {
+            ChromeSharedPreferences.getInstance()
+                    .writeBoolean(SafeShieldBridge.PREF_BLOCK_ADULT, enabled);
+        } else if (PREF_SAFESEARCH.equals(preference.getKey())) {
+            ChromeSharedPreferences.getInstance()
+                    .writeBoolean(SafeShieldBridge.PREF_FORCE_SAFESEARCH, enabled);
+        } else if (PREF_DNS.equals(preference.getKey())) {
+            ChromeSharedPreferences.getInstance()
+                    .writeBoolean(SafeShieldBridge.PREF_FAMILY_DNS, enabled);
+        }
+        return true;
+    }
+}
