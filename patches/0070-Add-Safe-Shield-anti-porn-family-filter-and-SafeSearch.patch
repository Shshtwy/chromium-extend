diff --git a/chrome/browser/safe_shield/safe_shield_throttle.cc b/chrome/browser/safe_shield/safe_shield_throttle.cc
new file mode 100644
index 0000000000..91a2b3c4d5
--- /dev/null
+++ b/chrome/browser/safe_shield/safe_shield_throttle.cc
@@ -0,0 +1,148 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/safe_shield/safe_shield_throttle.h"
+
+#include "base/android/jni_android.h"
+#include "base/android/jni_string.h"
+#include "base/strings/string_util.h"
+#include "content/public/browser/navigation_handle.h"
+#include "content/public/browser/web_contents.h"
+#include "net/base/url_util.h"
+#include "url/gurl.h"
+
+namespace safe_shield {
+
+namespace {
+
+// Substring / pattern matching for known explicit adult & porn networks
+const char* const kExplicitPatterns[] = {
+    "porn", "xxx", "xvideos", "pornhub", "xhamster", "redtube",
+    "xnxx", "youporn", "chaturbate", "stripchat", "livejasmin",
+    "onlyfans", "cam4", "bongacams", "hentai", "rule34",
+    "brazzers", "tube8", "spankbang", "beeg", "fuq", "eporner"
+};
+
+bool MatchesExplicitFilter(const std::string& host) {
+  std::string lower_host = base::ToLowerASCII(host);
+  for (const char* pattern : kExplicitPatterns) {
+    if (lower_host.find(pattern) != std::string::npos) {
+      return true;
+    }
+  }
+  return false;
+}
+
+GURL MaybeRewriteSafeSearch(const GURL& url) {
+  std::string host = base::ToLowerASCII(url.host());
+  if (host.find("google.") != std::string::npos && url.has_query()) {
+    if (url.query().find("safe=") == std::string::npos) {
+      return net::AppendQueryParameter(url, "safe", "active");
+    }
+  } else if (host.find("bing.com") != std::string::npos && url.has_query()) {
+    if (url.query().find("adlt=") == std::string::npos) {
+      return net::AppendQueryParameter(url, "adlt", "strict");
+    }
+  } else if (host.find("duckduckgo.com") != std::string::npos && url.has_query()) {
+    if (url.query().find("kp=") == std::string::npos) {
+      return net::AppendQueryParameter(url, "kp", "1");
+    }
+  } else if (host.find("youtube.com") != std::string::npos && url.has_query()) {
+    if (url.query().find("safe=") == std::string::npos) {
+      return net::AppendQueryParameter(url, "safe", "active");
+    }
+  }
+  return url;
+}
+
+}  // namespace
+
+// static
+std::unique_ptr<SafeShieldThrottle> SafeShieldThrottle::MaybeCreateThrottleFor(
+    content::NavigationHandle* handle) {
+  if (!handle->IsInMainFrame() || handle->IsSameDocument()) {
+    return nullptr;
+  }
+  return std::make_unique<SafeShieldThrottle>(handle);
+}
+
+SafeShieldThrottle::SafeShieldThrottle(content::NavigationHandle* handle)
+    : content::NavigationThrottle(handle) {}
+
+SafeShieldThrottle::~SafeShieldThrottle() = default;
+
+content::NavigationThrottle::ThrottleCheckResult
+SafeShieldThrottle::WillStartRequest() {
+  return CheckNavigation();
+}
+
+content::NavigationThrottle::ThrottleCheckResult
+SafeShieldThrottle::WillRedirectRequest() {
+  return CheckNavigation();
+}
+
+content::NavigationThrottle::ThrottleCheckResult
+SafeShieldThrottle::CheckNavigation() {
+  const GURL& url = navigation_handle()->GetURL();
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return NavigationThrottle::PROCEED;
+  }
+
+  // Enforce SafeSearch parameters on search engines
+  GURL safe_url = MaybeRewriteSafeSearch(url);
+  if (safe_url != url) {
+    return NavigationThrottle::ThrottleCheckResult(
+        NavigationThrottle::CANCEL_AND_IGNORE);
+  }
+
+  // Check adult blocklist
+  std::string host = url.host();
+  if (MatchesExplicitFilter(host)) {
+    // Display blocked interstitial and cancel navigation
+    std::string html =
+        "<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Bloqueado por Modo Seguro</title><style>body{font-family:sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;height:100vh;margin:0;background:#121212;color:#eee;text-align:center;padding:24px}.shield{width:80px;height:80px;fill:#ff5252;margin-bottom:16px}h1{font-size:24px;margin-bottom:8px}p{font-size:15px;color:#aaa;max-width:320px;line-height:1.5}.btn{margin-top:24px;padding:12px 24px;background:#2196f3;color:#fff;border-radius:24px;text-decoration:none;font-weight:bold}</style></head><body><svg class="shield" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-1.95 15.5l-3.55-3.55 1.41-1.41 2.14 2.14 5.66-5.66 1.41 1.41-7.07 7.07z"/></svg><h1>Acceso Restringido</h1><p>Este sitio web ha sido bloqueado por el <b>Modo Seguro</b> porque contiene contenido para adultos no permitido.</p><a class="btn" href="javascript:history.back()">Volver a un sitio seguro</a></body></html>";
+
+    if (navigation_handle()->GetWebContents()) {
+      navigation_handle()->GetWebContents()->GetController().LoadURL(
+          GURL("data:text/html;charset=utf-8," + html),
+          content::Referrer(), ui::PAGE_TRANSITION_AUTO_SUBFRAME, std::string());
+    }
+    return NavigationThrottle::CANCEL;
+  }
+
+  return NavigationThrottle::PROCEED;
+}
+
+const char* SafeShieldThrottle::GetNameForLogging() {
+  return "SafeShieldThrottle";
+}
+
+}  // namespace safe_shield
