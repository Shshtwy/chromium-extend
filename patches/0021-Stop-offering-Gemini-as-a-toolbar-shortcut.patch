From 7171e6578959c0e8e61f833ff61b65e58238e4fb Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Sun, 16 Aug 2026 08:42:20 +0000
Subject: [PATCH 21/48] Stop offering Gemini as a toolbar shortcut

Patch 0019 removed the Ask Gemini button from the bottom bar, but the adaptive
toolbar is a separate feature with its own settings screen, and it listed Gemini
among the choices for the optional button in the top toolbar. Without this the
button could simply be put back from Appearance, Toolbar shortcut.

Only the Gemini option is withheld. The remaining shortcut choices are ordinary
browser features and keep working.
---
 .../settings/AdaptiveToolbarSettingsFragment.java    | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/adaptive/settings/AdaptiveToolbarSettingsFragment.java b/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/adaptive/settings/AdaptiveToolbarSettingsFragment.java
index bf6ed2314f..86dae33e39 100644
--- a/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/adaptive/settings/AdaptiveToolbarSettingsFragment.java
+++ b/chrome/browser/ui/android/toolbar/java/src/org/chromium/chrome/browser/toolbar/adaptive/settings/AdaptiveToolbarSettingsFragment.java
@@ -85,8 +85,16 @@ public class AdaptiveToolbarSettingsFragment extends ChromeBaseSettingsFragment
                     AdaptiveToolbarFeatures.isAdaptiveToolbarReadAloudEnabled(profile));
             mRadioButtonGroup.setCanUseTranslate(
                     AdaptiveToolbarFeatures.isTranslateEnabled(profile));
-            mRadioButtonGroup.setCanUseGlic(
-                    AdaptiveToolbarFeatures.isGlicEnabledForAdaptiveToolbar(context, profile));
+            // De-Googled build: never offer Gemini as a toolbar shortcut.
+            //
+            // Patch 0019 removed the Ask Gemini button from the bottom bar, but the
+            // adaptive toolbar is a separate feature with its own settings screen, and
+            // it listed Gemini as a choice for the optional button in the top toolbar.
+            // Without this the button could simply be put back from settings.
+            //
+            // Only the Gemini option is withheld. The rest of the shortcut choices are
+            // ordinary browser features and keep working.
+            mRadioButtonGroup.setCanUseGlic(false);
             maybeSetUiStateFromBundleArgs();
             mRadioButtonGroup.setStatePredictor(
                     new AdaptiveToolbarStatePredictor(
-- 
