From 9ec2a565d47bda87e590744b2c56b79650fb465d Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Thu, 20 Aug 2026 15:31:19 +0000
Subject: Let extension context menu items run their own command

Tapping uBlock Origin's "Block element" killed the browser. The stack was an
AssertionError out of ChromeContextMenuPopulator, from the catch-all at the end
of the item chain that fires when nobody recognises the id.

Nobody recognised it because the id was never one of ours. MenuModelBridge
builds each extension item with MENU_ITEM_ID set to a command id from the C++
menu model, and with a CLICK_LISTENER that calls activatedAt() back into that
model, which is the whole mechanism by which an extension command runs. Then
ContextMenuMediator walked every first-level MENU_ITEM row and overwrote
CLICK_LISTENER with its own, which routes the id to the populator. So the
extension's own listener was thrown away before it could ever fire, and the
command id it left behind went somewhere that only understands R.id values.

With asserts compiled out, as in a release build, the tap silently does nothing
instead of crashing. Either way no extension context menu item has ever worked.

An item that arrives with a listener already knows how to run itself, so it
keeps it. The only thing those listeners are missing is the dismissal that
clickItem does on the way out, so the fix wraps rather than replaces: run the
item's own listener, then close the menu if the item was enabled, behind the
same activity-is-going-away check clickItem uses. Items with no listener of
their own are untouched and still go through clickItem exactly as before.

This is not specific to Bare. Any desktop-android build with an extension that
adds a context menu item hits it; Bare only found it first because it ships one.

Checked on the phone: "Block element" now opens uBlock Origin's element picker
and the menu closes behind it, and an ordinary item, Copy link address, still
copies the link.
---
 .../contextmenu/ContextMenuMediator.java      | 36 ++++++++++++++++---
 1 file changed, 32 insertions(+), 4 deletions(-)

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/contextmenu/ContextMenuMediator.java b/chrome/android/java/src/org/chromium/chrome/browser/contextmenu/ContextMenuMediator.java
index aebe01b9b2..761316ce04 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/contextmenu/ContextMenuMediator.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/contextmenu/ContextMenuMediator.java
@@ -11,6 +11,7 @@ import static org.chromium.ui.listmenu.ListMenuItemProperties.ENABLED;
 import static org.chromium.ui.listmenu.ListMenuItemProperties.MENU_ITEM_ID;
 
 import android.app.Activity;
+import android.view.View;
 import android.widget.ListView;
 
 import androidx.annotation.IdRes;
@@ -127,10 +128,37 @@ public class ContextMenuMediator {
             if (item.type == ListItemType.MENU_ITEM
                     || item.type == ContextMenuItemType.CONTEXT_MENU_ITEM_WITH_ICON_BUTTON) {
                 // Note: this does NOT handle items inside submenus.
-                item.model.set(
-                        CLICK_LISTENER,
-                        // Note: clickItem already includes dismissDialog.
-                        (v) -> clickItem(item.model.get(MENU_ITEM_ID), item.model.get(ENABLED)));
+                //
+                // An item that arrived with a listener of its own already knows how to run
+                // itself, and overwriting it broke the only items that do. Extension items are
+                // the case: MenuModelBridge gives them a listener that calls back into the C++
+                // menu model, and their MENU_ITEM_ID is a command id from that model rather
+                // than an R.id. Replacing the listener sent that command id to
+                // ChromeContextMenuPopulator, which recognised none of it, fell through to the
+                // catch-all, and hit the assertion there. With asserts compiled out the tap
+                // just did nothing instead, which is how it looked in the field: uBlock
+                // Origin's "Block element" appeared in the menu and killed the browser.
+                //
+                // The one thing those listeners lack is the dismissal clickItem does, so that
+                // is all that gets added around them.
+                View.OnClickListener ownListener = item.model.get(CLICK_LISTENER);
+                if (ownListener != null) {
+                    item.model.set(
+                            CLICK_LISTENER,
+                            (v) -> {
+                                if (mActivity.isFinishing() || mActivity.isDestroyed()) return;
+                                ownListener.onClick(v);
+                                if (item.model.get(ENABLED)) mDismissDialog.run();
+                            });
+                } else {
+                    item.model.set(
+                            CLICK_LISTENER,
+                            // Note: clickItem already includes dismissDialog.
+                            (v) ->
+                                    clickItem(
+                                            item.model.get(MENU_ITEM_ID),
+                                            item.model.get(ENABLED)));
+                }
             }
             if (item.type == ContextMenuItemType.CONTEXT_MENU_ITEM_WITH_ICON_BUTTON) {
                 PropertyModel model = item.model;
