From 62985d1f0ec3de31331b2faac21327f7ac81f067 Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Wed, 19 Aug 2026 20:12:17 +0000
Subject: [PATCH 58/58] Ship the MV2 action schemas in the desktop-android
 build

browser_action and page_action are the Manifest V2 spellings of action, which
this configuration already builds. Upstream bundles their schemas only with the
full extensions system, but declares their API features unconditionally, so
here the feature existed while the schema did not.

GetAPISchema() in native_extension_bindings_system.cc turns that mismatch into
LOG_IF(FATAL, !schema), so the renderer aborted the instant any MV2 extension
touched chrome.browserAction. uBlock Origin does that from its background page
during startup, which presented as the extension reloading over and over, and
took the browser process down with it once.

Only the schemas were missing. The implementation is already present, through
extension_action_api and extension_action_handler, as is the Android action and
popup UI under chrome/browser/ui/android/extensions.
---
 chrome/common/extensions/api/api_sources.gni | 21 +++++++++++++++-----
 1 file changed, 16 insertions(+), 5 deletions(-)

diff --git a/chrome/common/extensions/api/api_sources.gni b/chrome/common/extensions/api/api_sources.gni
index e15cd42f87..b86cc426f6 100644
--- a/chrome/common/extensions/api/api_sources.gni
+++ b/chrome/common/extensions/api/api_sources.gni
@@ -60,9 +60,25 @@ if (enable_guest_view) {
 # registration. These do not generate the strong C++ types.
 uncompiled_sources_ = [
   "action.json",
+  # Bare: browser_action and page_action are the MV2 spellings of action.json
+  # above. Upstream only bundles them when the full extensions system is built,
+  # but their API features are declared unconditionally, so on desktop-android
+  # the feature exists while the schema does not. GetAPISchema() in
+  # native_extension_bindings_system.cc turns that mismatch into
+  # LOG_IF(FATAL, !schema) << "Unknown API", so the renderer aborts the moment
+  # any MV2 extension touches chrome.browserAction. uBlock Origin does this from
+  # its background page, which showed up as the extension endlessly reloading
+  # and eventually took the browser process down with it.
+  #
+  # The implementation side is already present in this configuration
+  # (extension_action_api, extension_action_handler and the Android action UI
+  # under chrome/browser/ui/android/extensions), so only the schemas were
+  # missing.
+  "browser_action.json",
   "browsing_data.json",
   "commands.json",
   "extension.json",
+  "page_action.json",
   "top_sites.json",
 ]
 
@@ -163,11 +179,6 @@ if (enable_extensions) {
     schema_sources_ += [ "pdf_viewer_private.idl" ]
   }
 
-  uncompiled_sources_ += [
-    "browser_action.json",
-    "page_action.json",
-  ]
-
   if (is_chromeos) {
     uncompiled_sources_ += [
       "chromeos_info_private.json",
-- 
