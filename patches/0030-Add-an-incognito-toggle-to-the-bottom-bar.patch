@@ -61,6 +61,17 @@ public class BottomBarActionEligibility {
     private static final boolean SHOW_BOTTOM_BAR_EXTRA_ACTION = false;
 
     /* package-private */ static int getEligibleExtraAction(@Nullable Profile profile) {
+        // De-Googled build: the spare slot opens an incognito tab.
+        //
+        // It previously held Ask Gemini, removed in an earlier patch, which left the bottom bar
+        // with four buttons and the layout unbalanced. Incognito is a useful destination that
+        // needs no account, and it restores the original five-button arrangement with the new tab
+        // button still centred.
+        return ActionId.INCOGNITO;
+    }
+
+    @SuppressWarnings("unused")
+    private static int getEligibleExtraActionUpstream(@Nullable Profile profile) {
         if (!SHOW_BOTTOM_BAR_EXTRA_ACTION) {
             return ACTION_NONE;
         }
