From 8760a2a4a93956f083be2b4bd41904603bbb5afb Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Sat, 15 Aug 2026 21:20:40 +0000
Subject: [PATCH 4/5] Remove the recurring variations and network-time
 callbacks to Google

Two periodic requests remained in the build regardless of user activity.

The variations seed is fetched on a schedule from clientservices.googleapis.com and carries a client identifier. The request scheduler is no longer created, so no fetch is ever performed. The server URLs are still constructed: GetVariationsServerURL routes an invalid GURL into base::debug::DumpWithoutCrashing, so blanking the URL constants would have replaced a network call with a crash dump on every attempt. Field trials continue to work from the built-in configuration.

Network time queries clients2.google.com/time/1/current to detect a skewed system clock. Android now joins ChromeOS and iOS in the existing platform condition on kNetworkTimeServiceQuerying, which is Chromium own designed off-switch - ShouldIssueTimeQuery simply returns false. The device clock is authoritative on this build.
---
 .../network_time/network_time_tracker.cc      | 10 +++++++---
 .../variations/service/variations_service.cc  | 19 ++++++++++++-------
 2 files changed, 19 insertions(+), 10 deletions(-)

diff --git a/components/network_time/network_time_tracker.cc b/components/network_time/network_time_tracker.cc
index ada5634005..c5c49c141a 100644
--- a/components/network_time/network_time_tracker.cc
+++ b/components/network_time/network_time_tracker.cc
@@ -57,9 +57,13 @@
 
 namespace network_time {
 
-// Network time queries are enabled on Android and all desktop platforms except
-// Chrome OS, which uses tlsdated to set the system time.
-#if BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_IOS)
+// Network time queries are enabled on all desktop platforms except Chrome OS,
+// which uses tlsdated to set the system time.
+//
+// De-Googled build: also disabled on Android. The query is a periodic callback
+// to a Google host (clients2.google.com/time/1/current) whose only purpose is
+// to detect a skewed system clock; the device clock is authoritative here.
+#if BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_IOS) || BUILDFLAG(IS_ANDROID)
 BASE_FEATURE(kNetworkTimeServiceQuerying, base::FEATURE_DISABLED_BY_DEFAULT);
 #else
 BASE_FEATURE(kNetworkTimeServiceQuerying, base::FEATURE_ENABLED_BY_DEFAULT);
diff --git a/components/variations/service/variations_service.cc b/components/variations/service/variations_service.cc
index 590b03e3fb..0cfd452d4b 100644
--- a/components/variations/service/variations_service.cc
+++ b/components/variations/service/variations_service.cc
@@ -926,13 +926,18 @@ void VariationsService::StartRepeatedVariationsSeedFetch() {
   insecure_variations_server_url_ = GetVariationsServerURL(USE_HTTP);
 
   DCHECK(!request_scheduler_);
-  request_scheduler_.reset(VariationsRequestScheduler::Create(
-      base::BindRepeating(&VariationsService::FetchVariationsSeed,
-                          weak_ptr_factory_.GetWeakPtr()),
-      local_state_));
-  // Note that the act of starting the scheduler will start the fetch, if the
-  // scheduler deems appropriate.
-  request_scheduler_->Start();
+
+  // De-Googled build: the request scheduler is deliberately not created, so no
+  // variations seed is ever fetched. The seed is downloaded periodically from a
+  // Google host and carries a client identifier, making it one of the browser's
+  // recurring callbacks.
+  //
+  // The server URLs above are still constructed so that nothing downstream sees
+  // an invalid GURL; GetVariationsServerURL() routes an invalid URL into
+  // base::debug::DumpWithoutCrashing(), so blanking the URL constants would
+  // trade the network call for a crash dump on every attempt.
+  //
+  // Field trials continue to work from the built-in configuration.
 }
 
 void VariationsService::FetchVariationsSeed() {
