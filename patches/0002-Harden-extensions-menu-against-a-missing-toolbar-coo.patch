From 14260b4b1d7f8a5dc7f0f0b499aa657844c66d96 Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Sat, 15 Aug 2026 04:07:03 +0000
Subject: [PATCH 2/6] Harden extensions menu against a missing toolbar
 coordinator

The extensions toolbar coordinator is only created for Desktop Android, but extension support can still be enabled on a phone-sized layout. Guard against a null coordinator and fall back to opening the extension management page rather than crashing.
---
 .../chrome/browser/ChromeTabbedActivity.java  | 35 ++++++++++++++-----
 chrome/android/junit/BUILD.gn                 |  1 +
 .../browser/ChromeTabbedActivityUnitTest.java | 34 ++++++++++++++++++
 3 files changed, 61 insertions(+), 9 deletions(-)
 create mode 100644 chrome/android/junit/src/org/chromium/chrome/browser/ChromeTabbedActivityUnitTest.java

diff --git a/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java b/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
index 99944c0391..9ea6b8fbb8 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
@@ -4504,17 +4504,15 @@ public class ChromeTabbedActivity extends ChromeActivity implements PreAttachInt
         } else if (id == R.id.extensions_menu_menu_id) {
             ExtensionsToolbarCoordinator coordinator =
                     getToolbarManager().getExtensionsToolbarCoordinator();
-            coordinator.showExtensionsMenu();
+            if (!showExtensionsMenu(coordinator)) {
+                // The extensions toolbar is currently only created for Desktop Android. Extension
+                // support can still be enabled on a phone-sized layout, so keep this menu action
+                // useful by opening the extension management page instead of crashing.
+                openManageExtensionsPage(currentTab);
+            }
             RecordUserAction.record("MobileMenuExtensionsMenu");
         } else if (id == R.id.manage_extensions_menu_id) {
-            LoadUrlParams params =
-                    new LoadUrlParams(
-                            UrlConstants.CHROME_EXTENSIONS_URL, PageTransition.AUTO_TOPLEVEL);
-            getTabCreator(/* incognito= */ false)
-                    .createNewTab(
-                            params,
-                            TabLaunchType.FROM_CHROME_UI,
-                            getCurrentTabModel().isIncognito() ? null : currentTab);
+            openManageExtensionsPage(currentTab);
             RecordUserAction.record("MobileMenuManageExtensions");
             Profile profile = mTabModelProfileSupplier.get();
             if (profile != null) {
@@ -4702,6 +4700,25 @@ public class ChromeTabbedActivity extends ChromeActivity implements PreAttachInt
         return true;
     }
 
+    @VisibleForTesting
+    static boolean showExtensionsMenu(@Nullable ExtensionsToolbarCoordinator coordinator) {
+        if (coordinator == null) {
+            return false;
+        }
+        coordinator.showExtensionsMenu();
+        return true;
+    }
+
+    private void openManageExtensionsPage(@Nullable Tab currentTab) {
+        LoadUrlParams params =
+                new LoadUrlParams(UrlConstants.CHROME_EXTENSIONS_URL, PageTransition.AUTO_TOPLEVEL);
+        getTabCreator(/* incognito= */ false)
+                .createNewTab(
+                        params,
+                        TabLaunchType.FROM_CHROME_UI,
+                        getCurrentTabModel().isIncognito() ? null : currentTab);
+    }
+
     private void openForeignSessionTab(String sessionTag, int tabId) {
         Profile profile = getTabModelSelector().getCurrentModel().getProfile();
         ForeignSessionHelper helper = new ForeignSessionHelper(profile);
