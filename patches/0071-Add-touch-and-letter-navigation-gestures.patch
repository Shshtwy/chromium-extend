+package org.chromium.chrome.browser.gestures;
+
+import android.os.Bundle;
+import androidx.preference.Preference;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.preferences.ChromeSharedPreferences;
+import org.chromium.chrome.browser.settings.ChromeBaseSettingsFragment;
+import org.chromium.components.browser_ui.settings.ChromeSwitchPreference;
+import org.chromium.components.browser_ui.settings.SettingsUtils;
+
+/** Settings fragment for navigation and shape drawing gestures. */
+public class GestureSettings extends ChromeBaseSettingsFragment
+        implements Preference.OnPreferenceChangeListener {
+    public static final String PREF_GESTURES_ENABLED = "Chrome.Gestures.Enabled";
+    public static final String PREF_EDGE_SWIPE = "Chrome.Gestures.EdgeSwipe";
+    public static final String PREF_DRAW_C = "Chrome.Gestures.DrawC";
+    public static final String PREF_SHOW_TRAIL = "Chrome.Gestures.ShowTrail";
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        getActivity().setTitle(R.string.gestures_settings_title);
+        SettingsUtils.addPreferencesFromResource(this, R.xml.gesture_preferences);
+
+        setupSwitch("gestures_master_toggle", PREF_GESTURES_ENABLED);
+        setupSwitch("gestures_edge_swipe", PREF_EDGE_SWIPE);
+        setupSwitch("gestures_draw_c", PREF_DRAW_C);
+        setupSwitch("gestures_show_trail", PREF_SHOW_TRAIL);
+    }
+
+    private void setupSwitch(String key, String prefKey) {
+        ChromeSwitchPreference pref = (ChromeSwitchPreference) findPreference(key);
+        if (pref != null) {
+            pref.setChecked(ChromeSharedPreferences.getInstance().readBoolean(prefKey, true));
+            pref.setOnPreferenceChangeListener(this);
+        }
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        boolean enabled = (boolean) newValue;
+        String key = preference.getKey();
+        if ("gestures_master_toggle".equals(key)) {
+            ChromeSharedPreferences.getInstance().writeBoolean(PREF_GESTURES_ENABLED, enabled);
+        } else if ("gestures_edge_swipe".equals(key)) {
+            ChromeSharedPreferences.getInstance().writeBoolean(PREF_EDGE_SWIPE, enabled);
+        } else if ("gestures_draw_c".equals(key)) {
+            ChromeSharedPreferences.getInstance().writeBoolean(PREF_DRAW_C, enabled);
+        } else if ("gestures_show_trail".equals(key)) {
+            ChromeSharedPreferences.getInstance().writeBoolean(PREF_SHOW_TRAIL, enabled);
+        }
+        return true;
+    }
+}
