+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.gestures;
+
+import android.graphics.PointF;
+import android.graphics.RectF;
+import java.util.List;
+
+/** Gesture recognizer for classifying touchscreen drawing strokes (e.g. 'C' for Close). */
+public class BrowserGestureRecognizer {
+    public enum GestureType {
+        NONE,
+        DRAW_C,
+        SWIPE_BACK,
+        SWIPE_FORWARD
+    }
+
+    private static final float MIN_STROKE_DISTANCE = 80f;
+
+    public static GestureType recognize(List<PointF> points) {
+        if (points == null || points.size() < 10) {
+            return GestureType.NONE;
+        }
+
+        RectF bounds = getBounds(points);
+        float width = bounds.width();
+        float height = bounds.height();
+
+        if (width < MIN_STROKE_DISTANCE && height < MIN_STROKE_DISTANCE) {
+            return GestureType.NONE;
+        }
+
+        // Check for 'C' Gesture:
+        // Starts at upper-right, curves to the left, goes down, and curves back to the bottom-right.
+        if (isGestureC(points, bounds)) {
+            return GestureType.DRAW_C;
+        }
+
+        return GestureType.NONE;
+    }
+
+    private static boolean isGestureC(List<PointF> points, RectF bounds) {
+        int n = points.size();
+        PointF start = points.get(0);
+        PointF end = points.get(n - 1);
+
+        float width = bounds.width();
+        float height = bounds.height();
+
+        // Aspect ratio check for standard 'C' curve
+        float ratio = width / Math.max(1f, height);
+        if (ratio < 0.4f || ratio > 2.2f) return false;
+
+        // Start and end points must be on the right half of the stroke
+        float rightThreshold = bounds.left + width * 0.4f;
+        if (start.x < rightThreshold || end.x < rightThreshold) {
+            return false;
+        }
+
+        // Start must be in upper half, end in lower half
+        float midY = bounds.top + height * 0.5f;
+        if (start.y > midY || end.y < midY) {
+            return false;
+        }
+
+        // Find the leftmost point (apex of the 'C' curve)
+        int minIndex = 0;
+        float minX = Float.MAX_VALUE;
+        for (int i = 0; i < n; i++) {
+            if (points.get(i).x < minX) {
+                minX = points.get(i).x;
+                minIndex = i;
+            }
+        }
+
+        // Apex must occur near the middle of the stroke sequence (not start or end)
+        if (minIndex < n * 0.2f || minIndex > n * 0.8f) {
+            return false;
+        }
+
+        // The apex must reach the left side of the bounding box
+        return minX <= bounds.left + width * 0.25f;
+    }
+
+    private static RectF getBounds(List<PointF> points) {
+        float minX = Float.MAX_VALUE, maxX = Float.MIN_VALUE;
+        float minY = Float.MAX_VALUE, maxY = Float.MIN_VALUE;
+
+        for (PointF p : points) {
+            if (p.x < minX) minX = p.x;
+            if (p.x > maxX) maxX = p.x;
+            if (p.y < minY) minY = p.y;
+            if (p.y > maxY) maxY = p.y;
+        }
+
+        return new RectF(minX, minY, maxX, maxY);
+    }
+}
