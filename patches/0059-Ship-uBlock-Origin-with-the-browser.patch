diff --git a/chrome/browser/extensions/bare_bundled_extensions_loader.cc b/chrome/browser/extensions/bare_bundled_extensions_loader.cc
new file mode 100644
index 0000000000..b8025e4e41
--- /dev/null
+++ b/chrome/browser/extensions/bare_bundled_extensions_loader.cc
@@ -0,0 +1,122 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/extensions/bare_bundled_extensions_loader.h"
+
+#include <stdint.h>
+
+#include <utility>
+#include <vector>
+
+#include "base/android/apk_assets.h"
+#include "base/files/file.h"
+#include "base/files/file_path.h"
+#include "base/files/file_util.h"
+#include "base/files/memory_mapped_file.h"
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/path_service.h"
+#include "base/task/thread_pool.h"
+#include "chrome/common/chrome_paths.h"
+
+namespace extensions {
+
+namespace {
+
+// uBlock Origin, shipped unmodified and keeping its published extension id, so
+// a copy installed from the store is recognised as the same extension rather
+// than a second one. See third_party/ublock_origin in the Bare repository for
+// where the file came from and its licence.
+constexpr char kUBlockOriginId[] = "cjpalhdlnbpafiamejdnhcphjbkeiagm";
+constexpr char kUBlockOriginVersion[] = "1.73.0";
+constexpr char kUBlockOriginAsset[] = "assets/bare/ublock_origin.crx";
+
+// The version is part of the filename so that shipping a newer crx lands in a
+// new file, rather than being mistaken for the copy already on disk.
+constexpr base::FilePath::CharType kUBlockOriginCrx[] =
+    FILE_PATH_LITERAL("ublock_origin-1.73.0.crx");
+constexpr base::FilePath::CharType kBundledDir[] =
+    FILE_PATH_LITERAL("BareBundledExtensions");
+
+// Copies a bundled crx out of the apk so the installer has a real file to read,
+// and returns where it landed. Assets inside an apk have no path of their own,
+// which is why this is needed at all.
+//
+// Returns an empty path on any failure: the extension is then simply not
+// offered, which is preferable to blocking startup over a pre-installed extra.
+base::FilePath ExtractBundledCrx() {
+  base::FilePath user_data;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &user_data)) {
+    return base::FilePath();
+  }
+
+  const base::FilePath dir = user_data.Append(kBundledDir);
+  if (!base::CreateDirectory(dir)) {
+    return base::FilePath();
+  }
+
+  const base::FilePath crx = dir.Append(kUBlockOriginCrx);
+  if (base::PathExists(crx)) {
+    // Already extracted by an earlier launch.
+    return crx;
+  }
+
+  base::MemoryMappedFile::Region region;
+  const int fd = base::android::OpenApkAsset(kUBlockOriginAsset, &region);
+  if (fd < 0) {
+    base::android::DumpLastOpenApkAssetFailure();
+    LOG(ERROR) << "Bare: bundled extension asset missing: "
+               << kUBlockOriginAsset;
+    return base::FilePath();
+  }
+
+  base::File asset(fd);
+  std::vector<uint8_t> contents(static_cast<size_t>(region.size));
+  if (!asset.ReadAndCheck(region.offset, contents)) {
+    LOG(ERROR) << "Bare: could not read bundled extension asset";
+    return base::FilePath();
+  }
+
+  if (!base::WriteFile(crx, contents)) {
+    LOG(ERROR) << "Bare: could not write bundled extension to " << crx;
+    return base::FilePath();
+  }
+
+  return crx;
+}
+
+base::DictValue BuildPrefs() {
+  base::DictValue prefs;
+
+  const base::FilePath crx = ExtractBundledCrx();
+  if (crx.empty()) {
+    return prefs;
+  }
+
+  base::DictValue entry;
+  entry.Set("external_crx", crx.value());
+  entry.Set("external_version", kUBlockOriginVersion);
+  prefs.Set(kUBlockOriginId, std::move(entry));
+  return prefs;
+}
+
+}  // namespace
+
+BareBundledExtensionsLoader::BareBundledExtensionsLoader() = default;
+
+BareBundledExtensionsLoader::~BareBundledExtensionsLoader() = default;
+
+void BareBundledExtensionsLoader::StartLoading() {
+  // Unpacking 4MB out of the apk is file work, so keep it off the UI thread.
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(&BuildPrefs),
+      base::BindOnce(&BareBundledExtensionsLoader::OnPrefsBuilt, this));
+}
+
+void BareBundledExtensionsLoader::OnPrefsBuilt(base::DictValue prefs) {
+  LoadFinished(std::move(prefs));
+}
+
+}  // namespace extensions
