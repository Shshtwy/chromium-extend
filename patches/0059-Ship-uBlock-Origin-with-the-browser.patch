+++ b/chrome/browser/extensions/external_provider_impl.cc
@@ -4,6 +4,8 @@
 
 #include "chrome/browser/extensions/external_provider_impl.h"
 
+#include "chrome/browser/extensions/bare_bundled_extensions_loader.h"
+
 #include <stddef.h>
 
 #include <algorithm>
@@ -923,6 +925,16 @@ void ExternalProviderImpl::CreateExternalProviders(
       ManifestLocation::kInvalidLocation, ManifestLocation::kExternalComponent,
       Extension::FROM_WEBSTORE | Extension::WAS_INSTALLED_BY_DEFAULT));
 
+#if BUILDFLAG(IS_ANDROID)
+  // Bare: extensions shipped inside the apk. Registered at kExternalPref, so
+  // they arrive on first run and are then the user's to keep or remove; a
+  // component extension could be neither disabled nor seen.
+  provider_list->push_back(std::make_unique<ExternalProviderImpl>(
+      service, base::MakeRefCounted<BareBundledExtensionsLoader>(), profile,
+      ManifestLocation::kExternalPref, ManifestLocation::kExternalPrefDownload,
+      Extension::NO_FLAGS));
+#endif
+
 #if BUILDFLAG(ENABLE_EXTENSIONS)
   if (base::FeatureList::IsEnabled(features::kInitialExternalExtensions)) {
     auto initial_external_extensions_provider =
diff --git a/chrome/browser/resources/bare/BUILD.gn b/chrome/browser/resources/bare/BUILD.gn
new file mode 100644
index 0000000000..02c5a0905b
--- /dev/null
+++ b/chrome/browser/resources/bare/BUILD.gn
@@ -0,0 +1,13 @@
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//build/config/android/rules.gni")
+
+# Extensions Bare ships inside the apk. Compression is disabled because
+# OpenApkAsset can only hand back assets that are stored uncompressed.
+android_assets("bare_bundled_extension_assets") {
+  disable_compression = true
+  renaming_sources = [ "ublock_origin.crx" ]
+  renaming_destinations = [ "bare/ublock_origin.crx" ]
+}
diff --git a/chrome/browser/resources/bare/README.md b/chrome/browser/resources/bare/README.md
new file mode 100644
index 0000000000..f6199e2f10
--- /dev/null
+++ b/chrome/browser/resources/bare/README.md
@@ -0,0 +1,17 @@
+# Bundled extensions
+
+`ublock_origin.crx` is deliberately **not** part of the patch series. It is a
+4MB signed binary from a third party, and carrying it as base64 inside a patch
+would make the series unreviewable and awkward to rebase.
+
+The file lives in the Bare repository instead, at:
+
+    third_party/ublock_origin/uBlockOrigin-1.73.0.crx
+
+Copy it here before building:
+
+    cp third_party/ublock_origin/uBlockOrigin-1.73.0.crx \
+       chrome/browser/resources/bare/ublock_origin.crx
+
+That directory also records where the file came from, its checksum, and its
+licence. uBlock Origin is GPL-3.0 and is redistributed unmodified.
-- 
