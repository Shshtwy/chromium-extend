+++ b/chrome/browser/extensions/bare_bundled_extensions_loader.h
@@ -0,0 +1,41 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_EXTENSIONS_BARE_BUNDLED_EXTENSIONS_LOADER_H_
+#define CHROME_BROWSER_EXTENSIONS_BARE_BUNDLED_EXTENSIONS_LOADER_H_
+
+#include "base/values.h"
+#include "chrome/browser/extensions/external_loader.h"
+
+namespace extensions {
+
+// Offers the extensions Bare ships inside the apk to the external provider
+// machinery.
+//
+// These are registered at kExternalPref rather than as component extensions, so
+// they install on first run and are then ordinary extensions: the user can
+// disable them, remove them, and they show up in the extensions list like
+// anything installed by hand. A component extension would be permanent and
+// invisible, which is not what shipping a content blocker should mean.
+class BareBundledExtensionsLoader : public ExternalLoader {
+ public:
+  BareBundledExtensionsLoader();
+
+  BareBundledExtensionsLoader(const BareBundledExtensionsLoader&) = delete;
+  BareBundledExtensionsLoader& operator=(const BareBundledExtensionsLoader&) =
+      delete;
+
+ protected:
+  ~BareBundledExtensionsLoader() override;
+
+  // ExternalLoader:
+  void StartLoading() override;
+
+ private:
+  void OnPrefsBuilt(base::DictValue prefs);
+};
+
+}  // namespace extensions
+
+#endif  // CHROME_BROWSER_EXTENSIONS_BARE_BUNDLED_EXTENSIONS_LOADER_H_
