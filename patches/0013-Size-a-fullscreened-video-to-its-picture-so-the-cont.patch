From 87123701a1e0cc6a8d44aced08b48f72599f0ac4 Mon Sep 17 00:00:00 2001
From: Chromium Extend <noreply@localhost>
Date: Sun, 16 Aug 2026 05:31:51 +0000
Subject: [PATCH 13/29] Size a fullscreened video to its picture so the
 controls sit on it

The generic :fullscreen rule stretches the fullscreen element edge to edge and
letterboxes the picture inside it with object-fit: contain. The UA media
controls lay out against the element box rather than the picture, so on a tall
phone screen the scrubber is pinned to the bottom of the display with a wide
band of black between it and the video.

Release bottom so height: auto resolves from the intrinsic aspect ratio instead
of filling the containing block, and re-centre with top plus translate.
translate is used because the existing rule sets transform: none !important.

The selector repeats :not(:root) deliberately. Both rules are UA origin and both
use !important, so specificity breaks the tie: :not(:root):fullscreen scores
(0,2,0) and a bare video:fullscreen would score (0,1,1) and lose, leaving
inset: 0 in place and forcing height: auto to resolve to the full viewport.

Verified on device: a 16:9 video reports a 252px element in a 448x997 viewport,
centred, and a video taller than the viewport is clamped by max-height and
pillarboxes at full height, where the controls already sit on the picture.

This affects native controls only. Sites that fullscreen a container rather than
the video element, such as YouTube, draw their own controls and are unchanged.
---
 .../blink/renderer/core/css/fullscreen.css    | 30 +++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/third_party/blink/renderer/core/css/fullscreen.css b/third_party/blink/renderer/core/css/fullscreen.css
index f90620f4f8..ff43a54f11 100644
--- a/third_party/blink/renderer/core/css/fullscreen.css
+++ b/third_party/blink/renderer/core/css/fullscreen.css
@@ -28,6 +28,36 @@ iframe:fullscreen {
   padding: 0 !important;
 }
 
+/* Size a fullscreened <video> to its picture instead of to the viewport.
+
+   The generic :fullscreen rule above stretches the element edge to edge and
+   letterboxes the picture inside it with object-fit: contain. The UA media
+   controls are laid out against the element box, not the picture, so on a tall
+   phone screen the scrubber is pinned to the bottom of the display with a wide
+   band of black between it and the video.
+
+   Releasing bottom lets height: auto resolve from the intrinsic aspect ratio
+   rather than filling the containing block, and top + translate re-centres it.
+   translate is used because the rule above sets transform: none !important.
+   The ::backdrop is already black, so the area around the picture is unchanged.
+
+   A video taller than the viewport is clamped by max-height and keeps the full
+   height, where the controls already sit on the picture.
+
+   The selector repeats :not(:root) so that it outweighs the rule above. Both
+   rules are UA origin and both use !important, so specificity decides the
+   winner: :not(:root):fullscreen scores (0,2,0), and without the :not() here
+   video:fullscreen would only score (0,1,1) and lose - leaving inset: 0 in
+   place, which forces height: auto to resolve to the full viewport instead of
+   to the aspect ratio. */
+video:not(:root):fullscreen {
+  bottom: auto !important;
+  top: 50% !important;
+  height: auto !important;
+  max-height: 100% !important;
+  translate: 0 -50% !important;
+}
+
 /* TODO(foolip): In the spec, there's a ::backdrop block with the properties
    shared with dialog::backdrop (see html.css). */
 :not(:root):fullscreen::backdrop {
